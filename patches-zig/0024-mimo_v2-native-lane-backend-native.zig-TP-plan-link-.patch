+
+/// Rank 1 behind the native server: the model rank 0 announces (hello), then every step rank 0 sends, until it stops.
+fn follow(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, session: *tp.Session, model_dir: []const u8, aot_dir: []const u8) !u8 {
+    if (session.cfg.world < 2 or session.cfg.rank == 0) return error.FollowNeedsRankOne;
+    var buf: std.ArrayList(i64) = .empty;
+    defer buf.deinit(gpa);
+    const h = try session.plan.recvGrow(gpa, &buf);
+    if (h.len < 5 or h[0] != @intFromEnum(mimo.native.Op.hello)) return error.NoHello;
+    const context: usize = @intCast(h[2]);
+    const slots: usize = @intCast(h[3]);
+    const drafts = h[4] != 0;
+    std.debug.print("[follow] rank {d}: context {d}, {d} slots, drafter {s}\n", .{ session.cfg.rank, context, slots, if (drafts) "on" else "off" });
+    const e = try mimo.native.Engine.init(gpa, io, d, model_dir, aot_dir, context, slots, drafts, session);
+    defer e.deinit();
+    std.debug.print("[follow] loaded; following\n", .{});
+    var steps: usize = 0;
+    while (true) {
+        const words = session.plan.recvGrow(gpa, &buf) catch |err| switch (err) {
+            error.PeerClosed => break,
+            else => return err,
+        };
+        if (!try e.follow(words)) break;
+        steps += 1;
+    }
+    std.debug.print("[follow] stopped after {d} steps\n", .{steps});
+    return 0;
+}
diff --git a/zig/src/families/mimo_v2/native.zig b/zig/src/families/mimo_v2/native.zig
new file mode 100644
index 00000000..da190f4c
--- /dev/null
+++ b/zig/src/families/mimo_v2/native.zig
@@ -0,0 +1,488 @@
+//! MiMo-V2.6-Flash behind the native server (ZIG-PLAN Z5): the lane backend over the Zig decode forward (forward.zig)
+//! and the DFlash drafter (dflash.zig), on one GPU or two TP ranks.
+//!
+//! - Rank 0 serves; before each GPU step (a forward window, a draft pass) it sends the step to the other rank over the
+//!   TP plan link (Jay Leaton's #636), as the Python engine's mirror sends PROMPT / DRAFT / DECODE chains; rank 1 runs
+//!   `tf-mimo follow` (follow.zig), which replays every step on its half of the model until rank 0 stops.
+//! - Prompts run as decode rows, 128 a forward (row-invariant: equal to serial decode rows) until the prompt kernels
+//!   land (Z6). The drafter's context is fed by every forward (taps + update), so drafting needs no absorb step.
+//! - Rejected draft rows are overwritten by the next window before any query reads them (Python's semantics): `keep`
+//!   moves nothing.
+//! - Draws: greedy is the first maximum; sampled rows use the lane core's keyed host sampler (exact_sampling.py).
+
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const lanes = @import("lanes");
+const tp = @import("tp");
+const load_ = @import("load.zig");
+const fwd = @import("forward.zig");
+const dflash = @import("dflash.zig");
+const be = lanes.backend;
+
+pub const model_type = "mimo_v2";
+pub const formats: []const []const u8 = &.{"exl3"};
+pub const default_context: i64 = 131072;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = fwd.DECODE_ROWS;
+
+pub const Options = struct { context: usize, drafts: bool, segments: usize = 1 };
+pub const LoneRun = *const fn (ctx: *anyopaque, s: *lanes.Stream, hooks: *anyopaque, committed: *const fn (*anyopaque) void, yield: *const fn (*anyopaque) bool) anyerror!bool;
+
+pub const Loaded = struct {
+    backend: be.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    free_streams: u32 = 1,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    lone: ?LoneRun = null,
+    target: *anyopaque, // no prompt cache (no snap_* decls): never read
+};
+
+/// The plan link's words: one GPU step each, executed by every rank in order.
+pub const Op = enum(i64) { hello = 0x31A0, forward = 1, draft = 2, stop = 3 };
+
+/// The acceptance of DFlash drafts at depth 1, 2, ... given the ones before (the Python drafter on the answer key's
+/// prompts, results/zig-z4), until a stream has its own.
+const draft_prior = [_]f64{ 0.789, 0.78, 0.801, 0.833, 0.833, 0.846, 0.825 };
+
+const slots_default: usize = 4;
+
+/// The model, its kernels and the TP session: what rank 0 serves and rank 1 follows.
+pub const Engine = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    w: load_.Weights,
+    k3: cuda.exl3.Kernels,
+    set: cuda.aot.Set,
+    model: fwd.Model,
+    dr: ?*dflash.Drafter = null,
+    session: ?*tp.Session = null,
+    s: cuda.Stream,
+    logits: []f32, // [128, V] host
+    words: std.ArrayList(i64) = .empty,
+
+    /// Load everything on this rank. `session`: the open TP session (world > 1), null on one GPU.
+    pub fn init(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, aot_dir: []const u8, context: usize, slots: usize, drafts: bool, session: ?*tp.Session) !*Engine {
+        const e = try gpa.create(Engine);
+        errdefer gpa.destroy(e);
+        e.* = .{ .gpa = gpa, .d = d, .w = undefined, .k3 = undefined, .set = undefined, .model = undefined, .s = undefined, .logits = &.{}, .session = session };
+        const rank: usize = if (session) |ss| ss.cfg.rank else 0;
+        const world: usize = if (session) |ss| ss.cfg.world else 1;
+        e.s = try cuda.Stream.init(d, false);
+        errdefer e.s.deinit();
+        e.w = try load_.load(gpa, io, d, dir, rank, world, rank == 0);
+        errdefer e.w.deinit();
+        e.k3 = try cuda.exl3.Kernels.load(d);
+        errdefer e.k3.deinit();
+        e.set = try cuda.aot.Set.load(gpa, io, d, 0, aot_dir);
+        errdefer e.set.deinit();
+        e.model = try fwd.Model.init(gpa, d, &e.w, &e.set, &e.k3, if (session) |ss| ss.comm() else null, context, fwd.DECODE_ROWS, slots, e.s);
+        errdefer e.model.deinit();
+        if (drafts) {
+            const ddir = try std.fmt.allocPrint(gpa, "{s}/dflash", .{dir});
+            defer gpa.free(ddir);
+            e.dr = try dflash.Drafter.init(gpa, io, &e.model, ddir, e.s);
+            e.model.dr = e.dr;
+        }
+        e.logits = try gpa.alloc(f32, fwd.DECODE_ROWS * e.w.full.vocab);
+        return e;
+    }
+
+    pub fn deinit(e: *Engine) void {
+        const gpa = e.gpa;
+        e.words.deinit(gpa);
+        gpa.free(e.logits);
+        if (e.dr) |dr| dr.deinit();
+        e.model.deinit();
+        e.set.deinit();
+        e.k3.deinit();
+        e.w.deinit();
+        e.s.deinit();
+        gpa.destroy(e);
+    }
+
+    fn send(e: *Engine, words: []const i64) !void {
+        if (e.session) |ss| try ss.plan.send(words);
+    }
+
+    /// A forward window on every rank; rank 0's logits [n, V] land in `logits`.
+    pub fn forward(e: *Engine, rows: []const fwd.Row, out: bool) !void {
+        e.words.clearRetainingCapacity();
+        try e.words.appendSlice(e.gpa, &.{ @intFromEnum(Op.forward), @intCast(rows.len) });
+        for (rows) |r| try e.words.appendSlice(e.gpa, &.{ r.slot, r.pos, r.token });
+        try e.send(e.words.items);
+        try e.model.graphed(e.s, rows, if (out) e.logits else null);
+    }
+
+    /// A draft pass on every rank: drafts [S, block - 1] into `out`.
+    pub fn draft(e: *Engine, tokens: []const i64, pos0: []const u32, slots: []const u32, out: []i32) !void {
+        e.words.clearRetainingCapacity();
+        try e.words.appendSlice(e.gpa, &.{ @intFromEnum(Op.draft), @intCast(tokens.len) });
+        for (tokens, pos0, slots) |t, p, s| try e.words.appendSlice(e.gpa, &.{ t, p, s });
+        try e.send(e.words.items);
+        try e.dr.?.draft(e.s, tokens, pos0, slots, out);
+    }
+
+    /// One step from the plan link, on a follower; false at stop.
+    pub fn follow(e: *Engine, words: []const i64) !bool {
+        if (words.len < 2) return error.ShortPlan;
+        const op: Op = @enumFromInt(words[0]);
+        const n: usize = @intCast(words[1]);
+        if (words.len != 2 + 3 * n) return error.BadPlan;
+        switch (op) {
+            .forward => {
+                var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+                if (n > rows.len) return error.BadPlan;
+                for (0..n) |i| rows[i] = .{ .slot = @intCast(words[2 + 3 * i]), .pos = @intCast(words[3 + 3 * i]), .token = words[4 + 3 * i] };
+                try e.model.graphed(e.s, rows[0..n], null);
+            },
+            .draft => {
+                var t: [16]i64 = undefined;
+                var p: [16]u32 = undefined;
+                var sl: [16]u32 = undefined;
+                var out: [16 * 16]i32 = undefined;
+                if (n > t.len) return error.BadPlan;
+                for (0..n) |i| {
+                    t[i] = words[2 + 3 * i];
+                    p[i] = @intCast(words[3 + 3 * i]);
+                    sl[i] = @intCast(words[4 + 3 * i]);
+                }
+                try e.dr.?.draft(e.s, t[0..n], p[0..n], sl[0..n], &out);
+            },
+            .stop => return false,
+            .hello => return error.LateHello,
+        }
+        return true;
+    }
+};
+
+/// The setup rank 0 announces first, so the follower builds the same model: [hello, 3, context, slots, drafts, 0, 0, 0].
+pub fn hello(context: usize, slots: usize, drafts: bool) [8]i64 {
+    return .{ @intFromEnum(Op.hello), 2, @intCast(context), @intCast(slots), @intFromBool(drafts), 0, 0, 0 };
+}
+
+const Lane = struct { slot: u32, held: [16]u32 = undefined, nheld: u32 = 0 };
+const ring = 1024;
+
+pub const Lanes = struct {
+    gpa: std.mem.Allocator,
+    e: *Engine,
+    lanes: std.AutoHashMapUnmanaged(*const lanes.Stream, Lane) = .empty,
+    free: u32, // slot bits
+    drawn: [ring]u32 = undefined,
+    next: u64 = 0,
+    costs: [8]lanes.config.Cost = undefined,
+    shared: [32]lanes.config.Cost = undefined,
+    nshared: usize = 0,
+    draft_ms: f64 = 0,
+
+    fn of(p: *anyopaque) *Lanes {
+        return @ptrCast(@alignCast(p));
+    }
+
+    pub fn backend(l: *Lanes) be.Backend {
+        return .{ .ptr = l, .vtable = &.{ .prefill = prefillFn, .first = firstFn, .queue = queueFn, .read = readFn, .verify = verifyFn, .keep = keepFn, .draft = draftFn, .release = releaseFn } };
+    }
+
+    pub fn facts(l: *const Lanes) lanes.Model {
+        const drafting = l.e.dr != null;
+        const B: u32 = if (l.e.dr) |dr| @intCast(dr.block) else 1;
+        return .{
+            .exact_width = B,
+            .gpu_tokens = false,
+            .mtp = drafting,
+            .speculate = drafting,
+            .speculate_early = false,
+            .draft_prior = &draft_prior,
+            .drafts = B - 1,
+            .window_costs = l.costs[0..B],
+            .mtp_step_ms = l.draft_ms,
+            .hidden_rows = true,
+            .batch_rows = fwd.DECODE_ROWS,
+            .max_streams = @intCast(l.e.model.slots),
+            .shared_costs = l.shared[0..l.nshared],
+            .draft_streams = true,
+        };
+    }
+
+    /// Forward costs at load (graphed, after a warm-up): one stream's windows of 1 .. block rows, shared windows of
+    /// 2 .. 32 rows over up to `slots` streams, and a one-stream draft pass. Rows land at positions 64 .. of each slot
+    /// (every stream's prefill overwrites them).
+    pub fn measure(l: *Lanes, io: std.Io) !void {
+        const e = l.e;
+        const B: usize = if (e.dr) |dr| dr.block else 1;
+        var rows: [32]fwd.Row = undefined;
+        const reps = 6;
+        for (1..B + 1) |w| {
+            for (0..w) |j| rows[j] = .{ .slot = 0, .pos = @intCast(64 + j), .token = 1000 };
+            l.costs[w - 1] = .{ .width = @intCast(w), .ms = try l.time(io, rows[0..w], reps) };
+        }
+        l.nshared = 0;
+        const S = e.model.slots;
+        for (2..33) |n| {
+            for (0..n) |j| rows[j] = .{ .slot = @intCast(j % S), .pos = @intCast(64 + j / S), .token = 1000 };
+            l.shared[l.nshared] = .{ .width = @intCast(n), .ms = try l.time(io, rows[0..n], reps) };
+            l.nshared += 1;
+        }
+        if (e.dr) |dr| {
+            var out: [16]i32 = undefined;
+            try e.draft(&.{1000}, &.{64}, &.{0}, &out);
+            const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            for (0..reps) |_| try e.draft(&.{1000}, &.{64}, &.{0}, &out);
+            l.draft_ms = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6 / reps;
+            _ = dr;
+        }
+        std.log.info("mimo costs: window ms {d:.2} .. {d:.2} (1 .. {d} rows), shared 32 rows {d:.2}, draft {d:.2}", .{ l.costs[0].ms, l.costs[B - 1].ms, B, l.shared[l.nshared - 1].ms, l.draft_ms });
+    }
+
+    fn time(l: *Lanes, io: std.Io, rows: []const fwd.Row, reps: usize) !f64 {
+        try l.e.forward(rows, false); // capture
+        try l.e.s.synchronize();
+        const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+        for (0..reps) |_| try l.e.forward(rows, false);
+        try l.e.s.synchronize();
+        return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6 / @as(f64, @floatFromInt(reps));
+    }
+
+    fn take(l: *Lanes, token: u32) u64 {
+        const h = l.next;
+        l.drawn[h % ring] = token;
+        l.next += 1;
+        return h;
+    }
+
+    fn value(l: *const Lanes, feed: be.Feed) u32 {
+        return switch (feed) {
+            .handle => |h| l.drawn[h % ring],
+            .value => |v| v,
+        };
+    }
+
+    fn rowOf(l: *Lanes, r: usize) []const f32 {
+        const V = l.e.w.full.vocab;
+        return l.e.logits[r * V ..][0..V];
+    }
+
+    fn prefillFn(p: *anyopaque, s: *lanes.Stream) anyerror!void {
+        const l = of(p);
+        const e = l.e;
+        const ids = s.prompt();
+        const B: usize = if (e.dr) |dr| dr.block else 1;
+        if (ids.len == 0 or ids.len + s.max_new + B > e.model.context) return error.PromptTooLong;
+        const gop = try l.lanes.getOrPut(l.gpa, s);
+        if (!gop.found_existing) {
+            if (l.free == 0) {
+                l.lanes.removeByPtr(gop.key_ptr);
+                return error.NoFreeSlot;
+            }
+            const slot: u32 = @ctz(l.free);
+            l.free &= ~(@as(u32, 1) << @intCast(slot));
+            gop.value_ptr.* = .{ .slot = slot };
+        }
+        gop.value_ptr.nheld = 0;
+        const slot = gop.value_ptr.slot;
+        s.cached = 0;
+        var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+        var at: usize = 0;
+        while (at < ids.len) {
+            if (s.isCancelled()) return error.Cancelled;
+            const n = @min(fwd.DECODE_ROWS, ids.len - at);
+            for (0..n) |j| rows[j] = .{ .slot = slot, .pos = @intCast(at + j), .token = ids[at + j] };
+            const last = at + n == ids.len;
+            try e.forward(rows[0..n], last);
+            if (last) _ = l.take(try draw(l.gpa, l.rowOf(n - 1), s.sampling, ids.len));
+            at += n;
+        }
+    }
+
+    fn firstFn(p: *anyopaque, s: *lanes.Stream, position: u64) anyerror!u64 {
+        const l = of(p);
+        if (position != s.prompt_len) return error.PositionMismatch;
+        return l.next - 1;
+    }
+
+    fn queueFn(_: *anyopaque, _: *lanes.Stream, _: be.Feed, _: u64) anyerror!u64 {
+        return error.NotPipelined;
+    }
+
+    fn readFn(p: *anyopaque, handle: u64) anyerror!u32 {
+        const l = of(p);
+        if (handle >= l.next or l.next - handle > ring) return error.NoSuchToken;
+        return l.drawn[handle % ring];
+    }
+
+    /// Every window's rows in one forward; each row drawn with its stream's sampling at its keyed position.
+    fn verifyFn(p: *anyopaque, windows: []const be.Window, out: []be.Verified) anyerror!void {
+        const l = of(p);
+        var rows: [fwd.DECODE_ROWS]fwd.Row = undefined;
+        var n: usize = 0;
+        for (windows) |w| {
+            if (w.parents != null) return error.TreesNotBuilt;
+            const lane = l.lanes.getPtr(w.stream) orelse return error.UnknownStream;
+            if (n + w.rows() > rows.len) return error.WindowTooWide;
+            if (w.held > lane.nheld) return error.NoHeldDrafts;
+            for (0..w.rows()) |r| {
+                const tok: u32 = if (r == 0) w.pending else if (w.held > 0) lane.held[r - 1] else w.tokens[r - 1];
+                rows[n] = .{ .slot = lane.slot, .pos = @intCast(w.positions[r] - 1), .token = tok };
+                n += 1;
+            }
+        }
+        try l.e.forward(rows[0..n], true);
+        var r0: usize = 0;
+        for (windows, out) |w, *o| {
+            const lane = l.lanes.getPtr(w.stream).?;
+            for (0..w.rows()) |r| o.sampled[r] = try draw(l.gpa, l.rowOf(r0 + r), w.stream.sampling, w.positions[r]);
+            if (w.held > 0) @memcpy(o.drafts, lane.held[0..w.held]) else @memcpy(o.drafts, w.tokens);
+            r0 += w.rows();
+        }
+    }
+
+    fn keepFn(_: *anyopaque, _: []const be.Window, paths: []const []const u32) anyerror!void {
+        for (paths) |path| {
+            if (path.len == 0) return error.EmptyPath;
+            for (path, 0..) |r, i| if (r != i) return error.TreesNotBuilt;
+        }
+    }
+
+    /// One draft pass for every request that asks for drafts (their contexts are fed already).
+    fn draftFn(p: *anyopaque, requests: []const be.DraftRequest) anyerror!void {
+        const l = of(p);
+        const dr = l.e.dr orelse return error.NoDraftHead;
+        var toks: [16]i64 = undefined;
+        var pos0: [16]u32 = undefined;
+        var sl: [16]u32 = undefined;
+        var who: [16]*Lane = undefined;
+        var depth: [16]u32 = undefined;
+        var n: usize = 0;
+        for (requests) |r| {
+            const lane = l.lanes.getPtr(r.stream) orelse return error.UnknownStream;
+            lane.nheld = 0;
+            if (r.depth == 0) continue;
+            if (n == toks.len) return error.TooManyStreams;
+            const pending: u32 = if (r.follow.len > 0) r.follow[r.follow.len - 1] else l.value(r.first orelse return error.NoFirstToken);
+            toks[n] = pending;
+            pos0[n] = @intCast(r.position - 1);
+            sl[n] = lane.slot;
+            who[n] = lane;
+            depth[n] = @min(r.depth, @as(u32, @intCast(dr.block - 1)));
+            n += 1;
+        }
+        if (n == 0) return;
+        var out: [16 * 16]i32 = undefined;
+        try l.e.draft(toks[0..n], pos0[0..n], sl[0..n], &out);
+        for (0..n) |i| {
+            for (0..depth[i]) |j| who[i].held[j] = @intCast(out[i * (dr.block - 1) + j]);
+            who[i].nheld = depth[i];
+        }
+    }
+
+    fn releaseFn(p: *anyopaque, s: *lanes.Stream) void {
+        const l = of(p);
+        const kv = l.lanes.fetchRemove(s) orelse return;
+        l.free |= @as(u32, 1) << @intCast(kv.value.slot);
+    }
+};
+
+/// The token for a row: the first maximum when greedy (or temperature 0), else the keyed sampler over the top-k.
+pub fn draw(gpa: std.mem.Allocator, row: []const f32, settings: ?lanes.Sampling, position: u64) !u32 {
+    const best = fwd.argmax(row);
+    if (!std.math.isFinite(row[best])) return error.NonfiniteLogits;
+    const sampling = settings orelse return @intCast(best);
+    if (sampling.temperature <= 0) return @intCast(best);
+    const k = if (sampling.top_k == 0) row.len else @min(row.len, sampling.top_k);
+    const values = try gpa.alloc(f64, k);
+    defer gpa.free(values);
+    const ids = try gpa.alloc(u64, k);
+    defer gpa.free(ids);
+    var filled: usize = 0;
+    for (row, 0..) |x32, id| {
+        const x: f64 = x32;
+        if (k == row.len) {
+            values[id] = x;
+            ids[id] = id;
+            continue;
+        }
+        if (filled == k and x <= values[k - 1]) continue;
+        var at = @min(filled, k - 1);
+        while (at > 0 and x > values[at - 1]) : (at -= 1) {
+            values[at] = values[at - 1];
+            ids[at] = ids[at - 1];
+        }
+        values[at] = x;
+        ids[at] = id;
+        filled = @min(filled + 1, k);
+    }
+    return @intCast(try lanes.sampling.choose(gpa, values, ids, position, sampling));
+}
+
+const Owned = struct { gpa: std.mem.Allocator, e: *Engine, l: Lanes, session: ?*tp.Session };
+
+fn env(name: [:0]const u8) ?[]const u8 {
+    return std.mem.span(std.c.getenv(name) orelse return null);
+}
+
+/// The native family entry: TF_TP_* for two ranks (rank 0 serves; start `tf-mimo follow` on rank 1),
+/// TF_MIMO_AOT (the captured Triton set, required), TF_MIMO_SLOTS (streams, default 4).
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    const aot_dir = kernels orelse env("TF_MIMO_AOT") orelse return error.NoCapturedTritonSet;
+    const slots: usize = if (env("TF_MIMO_SLOTS")) |t| try std.fmt.parseInt(usize, t, 10) else slots_default;
+    if (slots == 0 or slots > 16) return error.Slots;
+    var session: ?*tp.Session = null;
+    const cfg = tp.Config.fromEnv() catch null;
+    if (cfg) |c| if (c.world > 1) {
+        if (c.rank != 0) return error.FollowerServes; // rank 1 runs `tf-mimo follow`
+        const ss = try gpa.create(tp.Session);
+        errdefer gpa.destroy(ss);
+        try ss.open(ctx.d, c, "");
+        session = ss;
+        const h = hello(o.context, slots, o.drafts);
+        try ss.plan.send(&h);
+    };
+    errdefer if (session) |ss| {
+        ss.announceStop();
+        ss.close();
+        gpa.destroy(ss);
+    };
+    const e = try Engine.init(gpa, io, ctx.d, dir, aot_dir, o.context, slots, o.drafts, session);
+    errdefer e.deinit();
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .e = e, .l = .{ .gpa = gpa, .e = e, .free = if (slots == 32) ~@as(u32, 0) else (@as(u32, 1) << @intCast(slots)) - 1 }, .session = session };
+    try own.l.measure(io);
+    return .{
+        .backend = own.l.backend(),
+        .facts = own.l.facts(),
+        .rows = if (e.dr) |dr| @intCast(dr.block) else 1,
+        .stream_bytes = 0,
+        .free_streams = @intCast(slots),
+        .ctx = own,
+        .deinit = release,
+        .target = own,
+    };
+}
+
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.PromptTooLong => "the prompt and its reply exceed this server's context window: shorten it or lower max_tokens",
+        error.NoFreeSlot => "every stream slot is busy: retry once another request ends",
+        else => null,
+    };
+}
+
+fn release(p: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(p));
+    if (own.session) |ss| {
+        ss.plan.send(&.{ @intFromEnum(Op.stop), 0 }) catch {};
+    }
+    own.l.lanes.deinit(own.gpa);
+    own.e.deinit();
+    if (own.session) |ss| {
+        ss.announceStop();
+        ss.close();
+        own.gpa.destroy(ss);
+    }
+    own.gpa.destroy(own);
+}
