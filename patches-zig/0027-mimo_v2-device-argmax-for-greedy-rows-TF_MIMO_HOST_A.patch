+    ids: [fwd.DECODE_ROWS]i32 = undefined, // device argmax of each row (Want.ids)
+    /// TF_MIMO_HOST_ARGMAX=1: greedy rows read back whole and scanned on the host (the Z5 path) instead of on the device.
+    host_argmax: bool = false,
     words: std.ArrayList(i64) = .empty,
 
     /// Load everything on this rank. `session`: the open TP session (world > 1), null on one GPU.
@@ -88,6 +91,7 @@ pub const Engine = struct {
             e.model.dr = e.dr;
         }
         e.logits = try gpa.alloc(f32, fwd.DECODE_ROWS * e.w.full.vocab);
+        e.host_argmax = if (std.c.getenv("TF_MIMO_HOST_ARGMAX")) |v| v[0] == '1' else false;
         return e;
     }
 
@@ -108,13 +112,21 @@ pub const Engine = struct {
         if (e.session) |ss| try ss.plan.send(words);
     }
 
-    /// A forward window on every rank; rank 0's logits [n, V] land in `logits`.
-    pub fn forward(e: *Engine, rows: []const fwd.Row, out: bool) !void {
+    pub const Want = enum { none, ids, logits };
+
+    /// A forward window on every rank; on rank 0 `ids` leaves each row's argmax in `ids`, `logits` the rows [n, V].
+    pub fn forward(e: *Engine, rows: []const fwd.Row, want: Want) !void {
         e.words.clearRetainingCapacity();
         try e.words.appendSlice(e.gpa, &.{ @intFromEnum(Op.forward), @intCast(rows.len) });
         for (rows) |r| try e.words.appendSlice(e.gpa, &.{ r.slot, r.pos, r.token });
         try e.send(e.words.items);
-        try e.model.graphed(e.s, rows, if (out) e.logits else null);
+        const w: Want = if (want == .ids and e.host_argmax) .logits else want;
+        try e.model.graphed(e.s, rows, if (w == .logits) e.logits else null);
+        if (want == .ids) {
+            if (e.host_argmax) {
+                for (0..rows.len) |r| e.ids[r] = @intCast(fwd.argmax(e.logits[r * e.w.full.vocab ..][0..e.w.full.vocab]));
+            } else try e.model.argmaxTo(e.s, rows.len, e.ids[0..rows.len]);
+        }
     }
 
     /// A draft pass on every rank: drafts [S, block - 1] into `out`.
@@ -239,10 +251,10 @@ pub const Lanes = struct {
     }
 
     fn time(l: *Lanes, io: std.Io, rows: []const fwd.Row, reps: usize) !f64 {
-        try l.e.forward(rows, false); // capture
+        try l.e.forward(rows, .ids); // capture
         try l.e.s.synchronize();
         const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
-        for (0..reps) |_| try l.e.forward(rows, false);
+        for (0..reps) |_| try l.e.forward(rows, .ids);
         try l.e.s.synchronize();
         return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6 / @as(f64, @floatFromInt(reps));
     }
@@ -292,8 +304,9 @@ pub const Lanes = struct {
             const n = @min(fwd.DECODE_ROWS, ids.len - at);
             for (0..n) |j| rows[j] = .{ .slot = slot, .pos = @intCast(at + j), .token = ids[at + j] };
             const last = at + n == ids.len;
-            try e.forward(rows[0..n], last);
-            if (last) _ = l.take(try draw(l.gpa, l.rowOf(n - 1), s.sampling, ids.len));
+            const greedy = s.sampling == null or s.sampling.?.temperature <= 0;
+            try e.forward(rows[0..n], if (!last) .none else if (greedy) .ids else .logits);
+            if (last) _ = l.take(if (greedy) @intCast(e.ids[n - 1]) else try draw(l.gpa, l.rowOf(n - 1), s.sampling, ids.len));
             at += n;
         }
     }
@@ -330,11 +343,15 @@ pub const Lanes = struct {
                 n += 1;
             }
         }
-        try l.e.forward(rows[0..n], true);
+        var all_greedy = true;
+        for (windows) |w| if (w.stream.sampling) |sm| if (sm.temperature > 0) {
+            all_greedy = false;
+        };
+        try l.e.forward(rows[0..n], if (all_greedy) .ids else .logits);
         var r0: usize = 0;
         for (windows, out) |w, *o| {
             const lane = l.lanes.getPtr(w.stream).?;
-            for (0..w.rows()) |r| o.sampled[r] = try draw(l.gpa, l.rowOf(r0 + r), w.stream.sampling, w.positions[r]);
+            for (0..w.rows()) |r| o.sampled[r] = if (all_greedy) @intCast(l.e.ids[r0 + r]) else try draw(l.gpa, l.rowOf(r0 + r), w.stream.sampling, w.positions[r]);
             if (w.held > 0) @memcpy(o.drafts, lane.held[0..w.held]) else @memcpy(o.drafts, w.tokens);
             r0 += w.rows();
         }
