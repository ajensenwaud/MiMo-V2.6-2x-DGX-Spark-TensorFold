@@ -241,3 +253,192 @@ fn windows(gpa: std.mem.Allocator, io: std.Io, model: *mimo.forward.Model, s: cu
     std.debug.print("{s} windows rank {d}: {d} rounds ({d} graphed: {d} captures, {d} replays), {d} rows: logits hash-equal to the Python window {d}/{d}, argmax equal {d}/{d}, equal to the serial answer key {d}/{d}; {d:.1}s\n", .{ if (ok) "PASS" else "FAIL", rank, sc.rounds.len, graph_rounds, model.captures, model.replays, total, sha_ok, total, am_ok, total, serial_ok, total, secs });
     return if (ok) 0 else 1;
