+
+fn sequences(gpa: std.mem.Allocator, model: *mimo.forward.Model, ora: *const core.safetensors.File, name: []const u8, ids_out: *[]i64, greedy_out: *[]i64) !void {
+    var nb: [128]u8 = undefined;
+    const ids_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.ids", .{name})) orelse return error.NoIds;
+    const greedy_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.greedy", .{name})) orelse return error.NoGreedy;
+    _ = model;
+    const ids = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, ids_t.bytes));
+    const gr = std.mem.bytesAsSlice(i32, @as([]align(1) const u8, greedy_t.bytes));
+    ids_out.* = try gpa.alloc(i64, ids.len);
+    for (ids, 0..) |t, i| ids_out.*[i] = t;
+    greedy_out.* = try gpa.alloc(i64, gr.len);
+    for (gr, 0..) |t, i| greedy_out.*[i] = t;
+}
+
+const DSched = struct {
+    block: usize,
+    prompts: std.json.ArrayHashMap(struct { len: usize, steps: []struct { drafts: []i32, accepted: usize } }),
+};
+
+/// Z4a: the Python drafter's protocol (tools/mimo_zig_dflash.py): a target row a step, then a draft from the next
+/// token; the Zig drafter's proposals against Python's, step by step.
+fn dflashCmp(gpa: std.mem.Allocator, io: std.Io, model: *mimo.forward.Model, s: cuda.Stream, ora: *const core.safetensors.File, path: []const u8, rank: usize) !u8 {
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 28));
+    defer gpa.free(text);
+    const parsed = try std.json.parseFromSlice(DSched, gpa, text, .{ .ignore_unknown_fields = true });
+    defer parsed.deinit();
+    const dr = model.dr.?;
+    if (parsed.value.block != dr.block) return error.BlockMismatch;
+    const V = model.w.full.vocab;
+    const logits = try gpa.alloc(f32, V);
+    defer gpa.free(logits);
+    var drafts: [16]i32 = undefined;
+    var steps: usize = 0;
+    var same_steps: usize = 0;
+    var same_tok: usize = 0;
+    var toks: usize = 0;
+    var acc_zig: usize = 0;
+    var acc_py: usize = 0;
+    var argmax_bad: usize = 0;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (prompts) |name| {
+        var ids: []i64 = undefined;
+        var greedy: []i64 = undefined;
+        try sequences(gpa, model, ora, name, &ids, &greedy);
+        defer gpa.free(ids);
+        defer gpa.free(greedy);
+        var seq: std.ArrayList(i64) = .empty;
+        defer seq.deinit(gpa);
+        try seq.appendSlice(gpa, ids);
+        for (greedy) |t| if (!model.w.full.isEos(@intCast(t))) try seq.append(gpa, t);
+        const py = parsed.value.prompts.map.get(name) orelse return error.NoPrompt;
+        if (py.len != seq.items.len) return error.SequenceMismatch;
+        var pz: usize = 0;
+        var pa: usize = 0;
+        for (0..seq.items.len - 1) |pos| {
+            try model.forward(s, &.{.{ .slot = 0, .pos = @intCast(pos), .token = seq.items[pos] }}, logits, null);
+            if (mimo.forward.argmax(logits) != seq.items[pos + 1] and pos + 1 >= ids.len) argmax_bad += 1;
+            try dr.draft(s, &.{seq.items[pos + 1]}, &.{@intCast(pos + 1)}, &.{0}, &drafts);
+            const want = py.steps[pos].drafts;
+            const nd = dr.block - 1;
+            var eq = true;
+            for (0..nd) |j| {
+                if (drafts[j] == want[j]) same_tok += 1 else eq = false;
+            }
+            toks += nd;
+            if (eq) same_steps += 1;
+            var acc: usize = 0;
+            while (acc < nd and pos + 2 + acc < seq.items.len and drafts[acc] == seq.items[pos + 2 + acc]) acc += 1;
+            pz += acc;
+            pa += py.steps[pos].accepted;
+            steps += 1;
+        }
+        acc_zig += pz;
+        acc_py += pa;
+        std.debug.print("[dflash] rank {d} {s}: {d} drafts, mean accepted zig {d:.2} / python {d:.2}\n", .{ rank, name, seq.items.len - 1, @as(f64, @floatFromInt(pz)) / @as(f64, @floatFromInt(seq.items.len - 1)), @as(f64, @floatFromInt(pa)) / @as(f64, @floatFromInt(seq.items.len - 1)) });
+    }
+    const secs = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9;
+    std.debug.print("dflash rank {d}: {d} drafts; whole blocks equal to Python's {d}/{d} ({d:.2}%), draft tokens equal {d}/{d} ({d:.3}%); accepted zig {d} vs python {d}; target argmax off the key {d}; {d:.1}s\n", .{ rank, steps, same_steps, steps, 100.0 * @as(f64, @floatFromInt(same_steps)) / @as(f64, @floatFromInt(steps)), same_tok, toks, 100.0 * @as(f64, @floatFromInt(same_tok)) / @as(f64, @floatFromInt(toks)), acc_zig, acc_py, argmax_bad, secs });
+    return if (argmax_bad == 0) 0 else 1;
+}
+
+/// Z4b: speculative decoding with the drafter, 4 streams a group (slots 0-3), each verify window graphed: every reply
+/// must equal the answer key's greedy reply (drafted == plain).
+fn drafted(gpa: std.mem.Allocator, io: std.Io, model: *mimo.forward.Model, s: cuda.Stream, ora: *const core.safetensors.File, rank: usize) !u8 {
+    const dr = model.dr.?;
+    const B = dr.block;
+    const V = model.w.full.vocab;
+    const logits = try gpa.alloc(f32, 128 * V);
+    defer gpa.free(logits);
+    var rows: [128]mimo.forward.Row = undefined;
+    var all_ok = true;
+    var total_tokens: usize = 0;
+    var total_forwards: usize = 0;
+    var drafted_n: usize = 0;
+    var accepted_n: usize = 0;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for ([_][]const []const u8{ prompts[0..4], prompts[4..8] }) |group| {
+        const S = group.len;
+        var ids: [4][]i64 = undefined;
+        var want: [4][]i64 = undefined;
+        var out: [4]std.ArrayList(i64) = @splat(.empty);
+        var done: [4]bool = @splat(false);
+        defer for (0..S) |k| {
+            gpa.free(ids[k]);
+            gpa.free(want[k]);
+            out[k].deinit(gpa);
+        };
+        for (group, 0..) |name, k| try sequences(gpa, model, ora, name, &ids[k], &want[k]);
+        // prompts as decode rows, 32 a window (row-invariant: equal to serial); the last row's argmax is the first token
+        for (0..S) |k| {
+            var at: usize = 0;
+            while (at < ids[k].len) {
+                const n = @min(32, ids[k].len - at);
+                for (0..n) |j| rows[j] = .{ .slot = @intCast(k), .pos = @intCast(at + j), .token = ids[k][at + j] };
+                try model.graphed(s, rows[0..n], logits);
+                total_forwards += 1;
+                at += n;
+                if (at == ids[k].len) try out[k].append(gpa, @intCast(mimo.forward.argmax(logits[(n - 1) * V ..][0..V])));
+            }
+            if (out[k].items.len >= want[k].len or model.w.full.isEos(@intCast(out[k].items[0]))) done[k] = true;
+        }
+        var drafts: [4 * 16]i32 = undefined;
+        while (true) {
+            var live: [4]usize = undefined;
+            var nl: usize = 0;
+            for (0..S) |k| if (!done[k]) {
+                live[nl] = k;
+                nl += 1;
+            };
+            if (nl == 0) break;
+            var toks: [4]i64 = undefined;
+            var p0: [4]u32 = undefined;
+            var sl: [4]u32 = undefined;
+            var width: [4]usize = undefined;
+            for (live[0..nl], 0..) |k, i| {
+                const p = ids[k].len + out[k].items.len - 1;
+                toks[i] = out[k].items[out[k].items.len - 1];
+                p0[i] = @intCast(p);
+                sl[i] = @intCast(k);
+                const room = @min(want[k].len - out[k].items.len, model.context - p) - 1;
+                width[i] = @min(B, room + 1);
+            }
+            try dr.draft(s, toks[0..nl], p0[0..nl], sl[0..nl], &drafts);
+            var n: usize = 0;
+            var starts: [4]usize = undefined;
+            for (live[0..nl], 0..) |k, i| {
+                starts[i] = n;
+                rows[n] = .{ .slot = @intCast(k), .pos = p0[i], .token = toks[i] };
+                n += 1;
+                for (1..width[i]) |j| {
+                    rows[n] = .{ .slot = @intCast(k), .pos = p0[i] + @as(u32, @intCast(j)), .token = drafts[i * (B - 1) + j - 1] };
+                    n += 1;
+                }
+                drafted_n += width[i] - 1;
+            }
+            try model.graphed(s, rows[0..n], logits);
+            total_forwards += 1;
+            for (live[0..nl], 0..) |k, i| {
+                var r: usize = 0;
+                while (true) {
+                    const tok: i64 = @intCast(mimo.forward.argmax(logits[(starts[i] + r) * V ..][0..V]));
+                    try out[k].append(gpa, tok);
+                    if (model.w.full.isEos(@intCast(tok)) or out[k].items.len >= want[k].len) {
+                        done[k] = true;
+                        break;
+                    }
+                    if (r + 1 < width[i] and rows[starts[i] + r + 1].token == tok) {
+                        r += 1;
+                        accepted_n += 1;
+                    } else break;
+                }
+            }
+        }
+        for (group, 0..) |name, k| {
+            const ok = std.mem.eql(i64, out[k].items, want[k]);
+            if (!ok) {
+                all_ok = false;
+                var first: usize = 0;
+                while (first < @min(out[k].items.len, want[k].len) and out[k].items[first] == want[k][first]) first += 1;
+                std.debug.print("FAIL drafted {s}: {d} tokens vs {d}, first difference at {d}\n", .{ name, out[k].items.len, want[k].len, first });
+            }
+            total_tokens += out[k].items.len;
+            std.debug.print("[drafted] rank {d} {s}: {d} tokens, {s}\n", .{ rank, name, out[k].items.len, if (ok) "equal to the answer key" else "DIFFERENT" });
+        }
+    }
+    const secs = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e9;
+    std.debug.print("{s} drafted rank {d}: 8 replies {s} the answer key's greedy replies; {d} tokens in {d} forwards ({d} prompt windows included); drafts accepted {d}/{d} ({d:.1}%); graphs {d} captured / {d} replayed; {d:.1}s\n", .{ if (all_ok) "PASS" else "FAIL", rank, if (all_ok) "byte-identical to" else "NOT equal to", total_tokens, total_forwards, 0, accepted_n, drafted_n, 100.0 * @as(f64, @floatFromInt(accepted_n)) / @as(f64, @floatFromInt(@max(drafted_n, 1))), model.captures, model.replays, secs });
+    return if (all_ok) 0 else 1;
+}
