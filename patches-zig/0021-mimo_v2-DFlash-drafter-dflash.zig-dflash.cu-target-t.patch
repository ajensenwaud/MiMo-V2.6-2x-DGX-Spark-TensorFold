diff --git a/zig/kernels/cuda/mimo_v2/dflash.cu b/zig/kernels/cuda/mimo_v2/dflash.cu
new file mode 100644
index 00000000..3744806b
--- /dev/null
+++ b/zig/kernels/cuda/mimo_v2/dflash.cu
@@ -0,0 +1,155 @@
+// MiMo-V2.6's DFlash drafter on the Zig engine: the torch glue of families/mimo_v2/cuda/dflash.py as fp32 CUDA.
+// The drafter only proposes tokens (the target verifies every one, so replies equal undrafted replies whatever it
+// proposes); these kernels follow dflash.py's arithmetic in fp32 but are not bit-identical to torch's reductions
+// (mean, einsum, softmax). Their proposals are compared with the Python drafter's (tf-mimo dflash). Built with the
+// glue flags (no FMA contraction: torch runs each elementwise op as its own kernel).
+
+#include <cuda_fp16.h>
+#include <cstdint>
+
+// x [S * B, D] fp32: row s * B = embed[tokens[s]] (bf16 -> fp32), rows s * B + 1 .. = mask_emb (fp32)
+extern "C" __global__ void dr_block_embed(const uint16_t* __restrict__ embed, const float* __restrict__ mask_emb,
+                                          const int64_t* __restrict__ tokens, float* __restrict__ x, int B, int D) {
+    const int r = blockIdx.x, s = r / B, b = r % B;
+    const uint16_t* row = embed + tokens[s] * (int64_t)D;
+    for (int d = threadIdx.x; d < D; d += blockDim.x)
+        x[(int64_t)r * D + d] = b == 0 ? __uint_as_float(((uint32_t)row[d]) << 16) : mask_emb[d];
+}
+
+// res fp32 [n, D] -> taps fp16 [n, NT * D] column block j (torch.cat(taps, -1).to(fp16))
+extern "C" __global__ void dr_tap(const float* __restrict__ res, __half* __restrict__ taps, int D, int NT, int j) {
+    const int r = blockIdx.x;
+    for (int d = threadIdx.x; d < D; d += blockDim.x)
+        taps[((int64_t)r * NT + j) * D + d] = __float2half_rn(res[(int64_t)r * D + d]);
+}
+
+// _head_rms then _rope: a block per (row, head), 128 threads (head_dim 128). x = in.float(); y = x * rsqrt(mean(x^2)
+// + eps) * w; the first ROT dims rotate NEOX-style with cos / sin at the row's position. Out: fp32 [n, NH, 128] when
+// out32, else fp16 into the cache at (slot, pos % ring).
+extern "C" __global__ void dr_norm_rope(const __half* __restrict__ in, const float* __restrict__ w,
+                                        const float* __restrict__ cos_t, const float* __restrict__ sin_t,
+                                        const int32_t* __restrict__ pos, const int32_t* __restrict__ slot,
+                                        float* __restrict__ out32, __half* __restrict__ cache, int NH, int ROT,
+                                        int ring, float eps) {
+    __shared__ float y[128];
+    __shared__ float part[4];
+    const int r = blockIdx.x, h = blockIdx.y, d = threadIdx.x;
+    const float x = __half2float(in[((int64_t)r * NH + h) * 128 + d]);
+    float sq = x * x;
+    for (int o = 16; o > 0; o >>= 1) sq += __shfl_xor_sync(0xffffffff, sq, o);
+    if ((d & 31) == 0) part[d >> 5] = sq;
+    __syncthreads();
+    const float mean = (part[0] + part[1] + part[2] + part[3]) / 128.0f;
+    y[d] = x * rsqrtf(mean + eps) * w[d];
+    __syncthreads();
+    const int half = ROT / 2;
+    const int p = pos[r];
+    float v = y[d];
+    if (d < ROT) {
+        const int j = d % half;
+        const float c = cos_t[(int64_t)p * half + j], s = sin_t[(int64_t)p * half + j];
+        v = d < half ? y[d] * c - y[d + half] * s : y[d] * c + y[d - half] * s;
+    }
+    if (out32) out32[((int64_t)r * NH + h) * 128 + d] = v;
+    else cache[(((int64_t)slot[r] * ring + p % ring) * NH + h) * 128 + d] = __float2half_rn(v);
+}
+
+// v rows fp16 [n, NH * 128] into the cache at (slot, pos % ring)
+extern "C" __global__ void dr_store(const __half* __restrict__ in, const int32_t* __restrict__ pos,
+                                    const int32_t* __restrict__ slot, __half* __restrict__ cache, int NH, int ring) {
+    const int r = blockIdx.x;
+    const int64_t at = ((int64_t)slot[r] * ring + pos[r] % ring) * NH * 128;
+    for (int i = threadIdx.x; i < NH * 128; i += blockDim.x) cache[at + i] = in[(int64_t)r * NH * 128 + i];
+}
+
+// Draft attention: a block per (row r = s * B + b, head h), 128 threads. Keys pos0[s] - (W - 1) + t, t < W - 1 + B,
+// visible when >= 0 and > the query's position - W (and within the block: all are); scores q.K * scale, the head's sink
+// logit as one more column; softmax; out fp16 [S * B, H * 128] = (p @ V).to(fp16).
+extern "C" __global__ void dr_attn(const float* __restrict__ q, const __half* __restrict__ kc,
+                                   const __half* __restrict__ vc, const float* __restrict__ sinks,
+                                   const int32_t* __restrict__ pos0, const int32_t* __restrict__ slot,
+                                   __half* __restrict__ out, int B, int W, int ring, int H, int KV, float scale) {
+    extern __shared__ float sc[];   // [W - 1 + B]
+    __shared__ float qs[128];
+    __shared__ float red[4];
+    const int r = blockIdx.x, h = blockIdx.y, s = r / B, b = r % B, tid = threadIdx.x;
+    const int kvh = h / (H / KV);
+    const int span = W - 1 + B;
+    const int p0 = pos0[s], qpos = p0 + b;
+    const int64_t base = (int64_t)slot[s] * ring;
+    qs[tid] = q[((int64_t)r * H + h) * 128 + tid];
+    __syncthreads();
+    const int warp = tid >> 5, lane = tid & 31;
+    for (int t = warp; t < span; t += 4) {
+        const int kp = p0 - (W - 1) + t;
+        float acc = 0.0f;
+        if (kp >= 0) {
+            const __half* k = kc + ((base + kp % ring) * KV + kvh) * 128;
+            for (int dd = lane; dd < 128; dd += 32) acc += qs[dd] * __half2float(k[dd]);
+        }
+        for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffff, acc, o);
+        if (lane == 0) sc[t] = (kp >= 0 && kp > qpos - W) ? acc * scale : -INFINITY;
+    }
+    __syncthreads();
+    const float sink = sinks ? sinks[h] : -INFINITY;
+    float m = sink;
+    for (int t = tid; t < span; t += 128) m = fmaxf(m, sc[t]);
+    for (int o = 16; o > 0; o >>= 1) m = fmaxf(m, __shfl_xor_sync(0xffffffff, m, o));
+    if (lane == 0) red[warp] = m;
+    __syncthreads();
+    m = fmaxf(fmaxf(red[0], red[1]), fmaxf(red[2], red[3]));
+    __syncthreads();
+    float l = 0.0f;
+    for (int t = tid; t < span; t += 128) {
+        const float e = sc[t] == -INFINITY ? 0.0f : expf(sc[t] - m);
+        sc[t] = e;
+        l += e;
+    }
+    for (int o = 16; o > 0; o >>= 1) l += __shfl_xor_sync(0xffffffff, l, o);
+    if (lane == 0) red[warp] = l;
+    __syncthreads();
+    l = red[0] + red[1] + red[2] + red[3] + (sinks ? expf(sink - m) : 0.0f);
+    float o = 0.0f;
+    for (int t = 0; t < span; ++t) {
+        const float e = sc[t];
+        if (e != 0.0f) {
+            const int kp = p0 - (W - 1) + t;
+            o += e * __half2float(vc[((base + kp % ring) * KV + kvh) * 128 + tid]);
+        }
+    }
+    out[((int64_t)r * H + h) * 128 + tid] = __float2half_rn(o / l);
+}
+
+// rows s * B + 1 .. s * B + B - 1 of x fp16 [S * B, D] -> [S * (B - 1), D]
+extern "C" __global__ void dr_take(const __half* __restrict__ x, __half* __restrict__ out, int B, int D) {
+    const int r = blockIdx.x, s = r / (B - 1), b = r % (B - 1) + 1;
+    for (int d = threadIdx.x; d < D; d += blockDim.x) out[(int64_t)r * D + d] = x[((int64_t)s * B + b) * D + d];
+}
+
+// logits[:, :vocab].argmax(-1) over the gathered head: recv [world, n, vr] fp32, row r = rank k's slice k * vr ..;
+// the first index of the maximum (torch.argmax). out int32 [n].
+extern "C" __global__ void dr_argmax(const float* __restrict__ recv, int32_t* __restrict__ out, int world, int n,
+                                     int vr, int vocab) {
+    __shared__ float bv[256];
+    __shared__ int bi[256];
+    const int r = blockIdx.x, tid = threadIdx.x;
+    float best = -INFINITY;
+    int idx = 0x7fffffff;
+    for (int c = tid; c < vocab; c += 256) {
+        const int k = c / vr, j = c % vr;
+        const float v = recv[((int64_t)k * n + r) * vr + j];
+        if (v > best || (v == best && c < idx)) { best = v; idx = c; }
+    }
+    bv[tid] = best;
+    bi[tid] = idx;
+    __syncthreads();
+    for (int o = 128; o > 0; o >>= 1) {
+        if (tid < o) {
+            const float v = bv[tid + o];
+            const int i = bi[tid + o];
+            if (v > bv[tid] || (v == bv[tid] && i < bi[tid])) { bv[tid] = v; bi[tid] = i; }
+        }
+        __syncthreads();
+    }
+    if (tid == 0) out[r] = bi[0];
+}
