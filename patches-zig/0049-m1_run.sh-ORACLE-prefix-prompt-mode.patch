From 77e3d935db25edd38adedde6c6c9e36c61d0241a Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 12 Oct 2026 06:54:42 +1100
Subject: [PATCH 49/71] m1_run.sh: ORACLE= prefix, prompt mode

---
 zig/src/families/mimo_v2/m1_run.sh | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/zig/src/families/mimo_v2/m1_run.sh b/zig/src/families/mimo_v2/m1_run.sh
index d4787f26..bed0aee0 100644
--- a/zig/src/families/mimo_v2/m1_run.sh
+++ b/zig/src/families/mimo_v2/m1_run.sh
@@ -11,11 +11,11 @@ args() {   # RANK ORACLE
        "-e TF_TP_WORLD=2 -e TF_TP_RANK=$1 -e TF_TP_MASTER=10.100.128.1 -e TF_TP_PORT=$PORT -e TF_COMM_BACKEND=${COMM:-nccl} -e TF_TP_ROCE_HCA=rocep1s0f0,roceP2p1s0f0 ${EXTRA_ENV:-}" \
        "-v $HOME/models/mimo-v2.6/MiMo-V2.6-Flash-RL-exl3-3.0bpw:/model:ro -v $HOME/mimo:/mimo" \
        "$(if [ -n "${NSYS:-}" ] && [ "$1" = 0 ]; then echo --entrypoint /usr/local/cuda/bin/nsys mimo-tf:latest profile -o /mimo/nsys/$NSYS --trace=cuda-sw,nvtx --force-overwrite true ${BIN:-/mimo/m1}/tf-mimo; else echo --entrypoint ${BIN:-/mimo/m1}/tf-mimo mimo-tf:latest; fi) ${MODE:-m1} /model $2 /mimo/oracle/${AOT:-aot2-sm121}" \
-       "$(case ${MODE:-m1} in windows|dflash) echo /mimo/oracle/${MODE}-r$1.json;; timing) echo;; *) echo ${CONTEXT:-4096};; esac)"
+       "$(case ${MODE:-m1} in windows|dflash) echo /mimo/oracle/${MODE}-r$1.json;; timing|prompt) echo;; *) echo ${CONTEXT:-4096};; esac)"
 }
-ssh -n "$WORKER" "docker rm -f mimo-m1 >/dev/null 2>&1; docker run $(args 1 /mimo/oracle/rank1.safetensors) > \$HOME/mimo/m1/${MODE:-m1}-r1.log 2>&1" </dev/null &
+ssh -n "$WORKER" "docker rm -f mimo-m1 >/dev/null 2>&1; docker run $(args 1 ${ORACLE:-/mimo/oracle/rank}1.safetensors) > \$HOME/mimo/m1/${MODE:-m1}-r1.log 2>&1" </dev/null &
 docker rm -f mimo-m1 >/dev/null 2>&1
-docker run $(args 0 /mimo/oracle/rank0.safetensors) > "$HOME/mimo/m1/${MODE:-m1}-r0.log" 2>&1
+docker run $(args 0 ${ORACLE:-/mimo/oracle/rank}0.safetensors) > "$HOME/mimo/m1/${MODE:-m1}-r0.log" 2>&1
 rc=$?
 wait
 echo "rank 0 rc $rc"
-- 
2.53.0

