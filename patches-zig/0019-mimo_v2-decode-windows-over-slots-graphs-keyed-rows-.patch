+const Sched = struct {
+    context: usize,
+    slots: usize,
+    rounds: []struct { mode: []const u8, chains: []struct { slot: u32, prompt: []const u8, p0: u32, n: u32 } },
+    rows: []struct { prompt: []const u8, pos: u32, argmax: u32, sha256: []const u8 },
+};
+
+/// Z3: the Python engine's window schedule (tools/mimo_zig_windows.py) replayed, graphed and eager as it ran; every
+/// row's fp32 logits must hash equal to the Python window's row, and its argmax equal the serial answer key's.
+fn windows(gpa: std.mem.Allocator, io: std.Io, model: *mimo.forward.Model, s: cuda.Stream, ora: *const core.safetensors.File, path: []const u8, rank: usize) !u8 {
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 28));
+    defer gpa.free(text);
+    const parsed = try std.json.parseFromSlice(Sched, gpa, text, .{ .ignore_unknown_fields = true });
+    defer parsed.deinit();
+    const sc = parsed.value;
+    if (sc.context != model.context or sc.slots > model.slots) return error.ScheduleShape;
+    const V = model.w.full.vocab;
+    var nb: [128]u8 = undefined;
+    // each prompt's teacher-forced sequence (prompt + non-EOS greedy) and its serial argmax
+    var seqs = std.StringHashMap([]i64).init(gpa);
+    defer {
+        var it = seqs.valueIterator();
+        while (it.next()) |v| gpa.free(v.*);
+        seqs.deinit();
+    }
+    var serial = std.StringHashMap([]align(1) const i32).init(gpa);
+    defer serial.deinit();
+    for (prompts) |name| {
+        const ids_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.ids", .{name})) orelse return error.NoIds;
+        const greedy_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.greedy", .{name})) orelse return error.NoGreedy;
+        const am_t = ora.get(try std.fmt.bufPrint(&nb, "{s}.argmax", .{name})) orelse return error.NoArgmax;
+        var l: std.ArrayList(i64) = .empty;
+        for (std.mem.bytesAsSlice(i32, @as([]align(1) const u8, ids_t.bytes))) |t| try l.append(gpa, t);
+        for (std.mem.bytesAsSlice(i32, @as([]align(1) const u8, greedy_t.bytes))) |t| if (!model.w.full.isEos(@intCast(t))) try l.append(gpa, t);
+        try seqs.put(name, try l.toOwnedSlice(gpa));
+        try serial.put(name, std.mem.bytesAsSlice(i32, @as([]align(1) const u8, am_t.bytes)));
+    }
+    const logits = try gpa.alloc(f32, 128 * V);
+    defer gpa.free(logits);
+    var rows: [128]mimo.forward.Row = undefined;
+    var at: usize = 0; // index into sc.rows
+    var sha_ok: usize = 0;
+    var am_ok: usize = 0;
+    var serial_ok: usize = 0;
+    var first: ?usize = null;
+    var graph_rounds: usize = 0;
+    const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+    for (sc.rounds, 0..) |rd, k| {
+        var n: usize = 0;
+        for (rd.chains) |c| {
+            const seq = seqs.get(c.prompt) orelse return error.UnknownPrompt;
+            for (0..c.n) |j| {
+                rows[n] = .{ .slot = c.slot, .pos = c.p0 + @as(u32, @intCast(j)), .token = seq[c.p0 + j] };
+                n += 1;
+            }
+        }
+        if (std.mem.eql(u8, rd.mode, "graph")) {
+            graph_rounds += 1;
+            try model.graphed(s, rows[0..n], logits);
