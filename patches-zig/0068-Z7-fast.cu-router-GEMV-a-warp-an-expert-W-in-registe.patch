index 00000000..95ca7b09
--- /dev/null
+++ b/zig/kernels/cuda/mimo_v2/fast.cu
@@ -0,0 +1,104 @@
+// MiMo-V2 decode-path fusions (ours, Z7; not bit-equal to the Python engine).
+//
+//   mimo_router     router logits OUT [n, NE] fp32 = x [n, D] fp16 . W [NE, D] fp16: a warp an expert, its row of W
+//                   held in registers across the window's rows (Triton _router ran 8 programs for one row: ~95 GB/s)
+//   mimo_add3_rms   the two ranks' fp32 partials summed into the residual (in place), then RMS-normed into fp16:
+//                   forward._sum's add + ops._add_rms in one pass (one launch, one read of each operand)
+
+#include <cstdint>
+#include <cuda_fp16.h>
+
+namespace mimo_fast {
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int x = 16; x >= 1; x /= 2) v += __shfl_xor_sync(0xffffffffu, v, x);
+    return v;
+}
+
+__device__ __forceinline__ float dot8(uint4 a, uint4 b) {
+    const __half2* x = reinterpret_cast<const __half2*>(&a);
+    const __half2* y = reinterpret_cast<const __half2*>(&b);
+    float s = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const float2 fx = __half22float2(x[i]), fy = __half22float2(y[i]);
+        s = fmaf(fx.x, fy.x, s);
+        s = fmaf(fx.y, fy.y, s);
+    }
+    return s;
+}
+
+} // namespace mimo_fast
+
+using namespace mimo_fast;
+
+// Grid (ceil(NE / 4)), 128 threads; D = 32 * 8 * PER (PER 16: D 4096).
+template <int PER>
+__device__ __forceinline__ void router_body(const __half* __restrict__ X, const __half* __restrict__ W,
+                                            float* __restrict__ OUT, int n, int x_stride, int NE) {
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32;
+    const int e = blockIdx.x * 4 + warp;
+    if (e >= NE) return;
+    constexpr int D = 32 * 8 * PER;
+    uint4 w[PER];
+    const uint4* wr = reinterpret_cast<const uint4*>(W + static_cast<int64_t>(e) * D);
+#pragma unroll
+    for (int i = 0; i < PER; ++i) w[i] = wr[lane + 32 * i];
+    for (int r = 0; r < n; ++r) {
+        const uint4* xr = reinterpret_cast<const uint4*>(X + static_cast<int64_t>(r) * x_stride);
+        float s = 0.0f;
+#pragma unroll
+        for (int i = 0; i < PER; ++i) s += dot8(xr[lane + 32 * i], w[i]);
+        s = warp_sum(s);
+        if (lane == 0) OUT[static_cast<int64_t>(r) * NE + e] = s;
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(128) mimo_router(const __half* __restrict__ X,
+                                                             const __half* __restrict__ W, float* __restrict__ OUT,
+                                                             int n, int x_stride, int NE) {
+    router_body<16>(X, W, OUT, n, x_stride, NE);
+}
+
+// Grid (n), 256 threads; D a multiple of 1024 (4096: four float4 a thread).
+extern "C" __global__ void __launch_bounds__(256) mimo_add3_rms(const float* __restrict__ A,
+                                                               const float* __restrict__ B, float* __restrict__ RES,
+                                                               const float* __restrict__ W, __half* __restrict__ OUT,
+                                                               int D, float eps) {
+    __shared__ float red[8];
+    const int64_t r = blockIdx.x;
+    const int t = threadIdx.x, per = D / 1024;
+    const float4* a = reinterpret_cast<const float4*>(A + r * D);
+    const float4* b = reinterpret_cast<const float4*>(B + r * D);
+    float4* res = reinterpret_cast<float4*>(RES + r * D);
+    float4 v[4];
+    float ss = 0.0f;
+    for (int i = 0; i < per; ++i) {
+        const int j = t + 256 * i;
+        const float4 x = a[j], y = b[j], z = res[j];
+        float4 o;
+        o.x = z.x + (x.x + y.x);
+        o.y = z.y + (x.y + y.y);
+        o.z = z.z + (x.z + y.z);
+        o.w = z.w + (x.w + y.w);
+        res[j] = o;
+        v[i] = o;
+        ss += o.x * o.x + o.y * o.y + o.z * o.z + o.w * o.w;
+    }
+    ss = warp_sum(ss);
+    if (t % 32 == 0) red[t / 32] = ss;
+    __syncthreads();
+    float tot = 0.0f;
+#pragma unroll
+    for (int w = 0; w < 8; ++w) tot += red[w];
+    const float rs = rsqrtf(tot / static_cast<float>(D) + eps);
+    const float4* wv = reinterpret_cast<const float4*>(W);
+    __half2* out = reinterpret_cast<__half2*>(OUT + r * D);
+    for (int i = 0; i < per; ++i) {
+        const int j = t + 256 * i;
+        const float4 g = wv[j];
+        out[2 * j] = __floats2half2_rn(v[i].x * rs * g.x, v[i].y * rs * g.y);
+        out[2 * j + 1] = __floats2half2_rn(v[i].z * rs * g.z, v[i].w * rs * g.w);
+    }
+}
