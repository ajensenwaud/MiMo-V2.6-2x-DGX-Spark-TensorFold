From ad08f7a3daaf0212393aab7c95a8b5d1d1407ce0 Mon Sep 17 00:00:00 2001
From: Anders Jensen-Waud <anders@jensenwaud.com>
Date: Sun, 11 Oct 2026 16:47:46 +1100
Subject: [PATCH 22/67] m1_run.sh: MODE=dflash|drafted

---
 zig/src/families/mimo_v2/m1_run.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/zig/src/families/mimo_v2/m1_run.sh b/zig/src/families/mimo_v2/m1_run.sh
index 0fea103e..9d0bfa60 100644
--- a/zig/src/families/mimo_v2/m1_run.sh
+++ b/zig/src/families/mimo_v2/m1_run.sh
@@ -11,7 +11,7 @@ args() {   # RANK ORACLE
        "-e TF_TP_WORLD=2 -e TF_TP_RANK=$1 -e TF_TP_MASTER=10.100.128.1 -e TF_TP_PORT=$PORT -e TF_COMM_BACKEND=nccl" \
        "-v $HOME/models/mimo-v2.6/MiMo-V2.6-Flash-RL-exl3-3.0bpw:/model:ro -v $HOME/mimo:/mimo" \
        "--entrypoint /mimo/m1/tf-mimo mimo-tf:latest ${MODE:-m1} /model $2 /mimo/oracle/${AOT:-aot2-sm121}" \
-       "$([ "${MODE:-m1}" = windows ] && echo /mimo/oracle/windows-r$1.json || echo ${CONTEXT:-4096})"
+       "$(case ${MODE:-m1} in windows|dflash) echo /mimo/oracle/${MODE}-r$1.json;; *) echo ${CONTEXT:-4096};; esac)"
 }
 ssh -n "$WORKER" "docker rm -f mimo-m1 >/dev/null 2>&1; docker run $(args 1 /mimo/oracle/rank1.safetensors) > \$HOME/mimo/m1/${MODE:-m1}-r1.log 2>&1" </dev/null &
 docker rm -f mimo-m1 >/dev/null 2>&1
