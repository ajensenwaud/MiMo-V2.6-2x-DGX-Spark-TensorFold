From: Anders Jensen-Waud <anders@jensenwaud.com>
Date: Sun, 11 Oct 2026 13:34:31 +1100
Subject: [PATCH 06/15] mimo_v2: sync.py generates the EXL3 kernel sources from
 the Python engine's

---
 zig/kernels/cuda/mimo_v2/sync.py | 148 +++++++++++++++++++++++++++++++
 1 file changed, 148 insertions(+)
 create mode 100644 zig/kernels/cuda/mimo_v2/sync.py

diff --git a/zig/kernels/cuda/mimo_v2/sync.py b/zig/kernels/cuda/mimo_v2/sync.py
new file mode 100644
index 00000000..b839a261
--- /dev/null
+++ b/zig/kernels/cuda/mimo_v2/sync.py
@@ -0,0 +1,148 @@
+#!/usr/bin/env python3
+"""Generates the MiMo Zig engine's EXL3 kernel sources from the Python engine's, so both run the same device code.
+
+Method after Jay Leaton's DeepSeek-V4.1 Zig port (github.com/jayleaton/deepseek-v41-tensorfold-spark,
+zig/kernels/cuda/deepseek_v41): copy each Python extension's device code verbatim, drop the torch includes and the
+at::Tensor bindings, give the anonymous namespace a name the loader can find, and keep every kernel instantiation
+the Python binding launches. The SASS of each kernel must then equal the Python build's (sass_check.sh).
+
+Source of truth: the TensorFold Python tree the MiMo release image serves (`--src`, a git checkout) at `--ref`.
+
+usage: sync.py --src ~/mimo/TensorFold --ref f3a8c11 [--check]   (writes next to this file; --check only compares)
+       sync.py --sources                                           (copy, key, repo, ref lines for sass_check.sh)
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+X = "src/tensorfold/cuda/exl3"
+DEFAULT_SRC = Path.home() / "mimo/TensorFold"
+DEFAULT_REF = "f3a8c11"
+
+TORCH_INCLUDES = ("#include <ATen/ATen.h>", "#include <ATen/cuda/CUDAContext.h>", "#include <c10/cuda/CUDAGuard.h>")
+
+
+def show(src: Path, ref: str, rel: str) -> str:
+    return subprocess.run(["git", "-C", str(src), "show", f"{ref}:{rel}"], check=True, capture_output=True,
+                          text=True).stdout
+
+
+def blob(src: Path, ref: str, rel: str) -> str:
+    return subprocess.run(["git", "-C", str(src), "rev-parse", "--short=12", f"{ref}:{rel}"], check=True,
+                          capture_output=True, text=True).stdout.strip()
+
+
+def header(src: Path, ref: str, rel: str, what: str) -> str:
+    return (f"// Device code of {rel.removeprefix('src/tensorfold/')} (git blob {blob(src, ref, rel)} at {ref}); {what}\n"
+            "// Generated by zig/kernels/cuda/mimo_v2/sync.py. Do not edit: change the Python source and regenerate.\n")
+
+
+def cut_device(text: str, ns: str) -> str:
+    """Device part of a binding .cu: torch includes swapped for <cstdint>, everything after the anonymous namespace
+    cut, the anonymous namespace named `ns`."""
+    lines = text.splitlines()
+    out: list[str] = []
+    swapped = False
+    for line in lines:
+        if line.strip() in TORCH_INCLUDES:
+            if not swapped:
+                out.append("#include <cstdint>  // what the cut torch includes provided: the fixed-width integers")
+                swapped = True
+            continue
+        out.append(line)
+    text = "\n".join(out) + "\n"
+    opens = [m.start() for m in re.finditer(r"^namespace \{$", text, re.M)]
+    closes = [m.end() for m in re.finditer(r"^\}  // namespace$", text, re.M)]
+    if len(opens) != 1 or len(closes) != 1:
+        raise SystemExit(f"expected one anonymous namespace, found {len(opens)} opens / {len(closes)} closes")
+    text = text[: closes[0]]
+    text = text.replace("namespace {", f"namespace {ns} {{", 1).replace("}  // namespace", f"}}  // namespace {ns}", 1)
+    return text + "\n"
+
+
+def macro(text: str, name: str) -> str:
+    m = re.search(rf"^#define {name}\(.*$", text, re.M)
+    if not m:
+        raise SystemExit(f"macro {name} not found")
+    return m.group(0)
+
+
+def linear(src: Path, ref: str) -> str:
+    rel = f"{X}/linear.cu"
+    text = show(src, ref, rel)
+    body = cut_device(text, "tf_exl3_linear")
+    widths, every = macro(text, "TF_EXL3_WIDTHS"), macro(text, "TF_EXL3_ALL")
+    refs = ("\n// Every instantiation exl3_linear_cuda / exl3_unpack_cuda can launch (TF_EXL3_ALL, copied from the binding):\n"
+            "// taking each kernel's address makes nvcc emit it, as the binding's launches do.\n"
+            f"{widths}\n{every}\n"
+            "#define TF_REF(K2_, CB_) (const void*)tf_exl3_linear::linear_kernel<K2_, CB_, 2>, \\\n"
+            "    (const void*)tf_exl3_linear::linear_kernel<K2_, CB_, 4>, (const void*)tf_exl3_linear::linear_kernel<K2_, CB_, 8>, \\\n"
+            "    (const void*)tf_exl3_linear::unpack_kernel<K2_, CB_>,\n"
+            "__attribute__((used)) static const void* const tf_exl3_linear_refs[] = {TF_EXL3_ALL(TF_REF)};\n"
+            "#undef TF_REF\n")
+    return header(src, ref, rel, "torch includes and host bindings cut.") + body + refs
+
+
+def experts(src: Path, ref: str) -> str:
+    rel = f"{X}/experts.cu"
+    text = show(src, ref, rel)
+    body = cut_device(text, "tf_exl3_experts")
+    # the binding instantiates rot_in_kernel per input dtype it accepts; down_combine / others are plain kernels
+    templ = re.findall(r"template <typename (\w+)>\s*\n__global__ void (?:__launch_bounds__\([^)]*\) )?(\w+)\(", body)
+    refs = ["\n// The kernel templates the binding launches, at each input dtype it accepts (bf16, fp16)."]
+    for _, name in templ:
+        refs.append(f"__attribute__((used)) static const void* const tf_ref_{name}[] = {{"
+                    f"(const void*)tf_exl3_experts::{name}<__nv_bfloat16>, (const void*)tf_exl3_experts::{name}<half>}};")
+    return header(src, ref, rel, "torch includes and host bindings cut.") + body + "\n".join(refs) + "\n"
+
+
+def verbatim(src: Path, ref: str, name: str) -> str:
+    rel = f"{X}/{name}"
+    return header(src, ref, rel, "verbatim.") + show(src, ref, rel)
+
+
+def outputs(src: Path, ref: str) -> dict[str, str]:
+    return {
+        "decode.cuh": verbatim(src, ref, "decode.cuh"),
+        "experts_grouped.cuh": verbatim(src, ref, "experts_grouped.cuh"),
+        # experts_cb2.cu instantiates grouped_launch<2> / dequant_launch<2>: mul1, the codebook MiMo's packs use
+        "exl3_experts_cb2.cu": verbatim(src, ref, "experts_cb2.cu"),
+        "exl3_linear.cu": linear(src, ref),
+        "exl3_experts.cu": experts(src, ref),
+    }
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--src", type=Path, default=DEFAULT_SRC)
+    ap.add_argument("--ref", default=DEFAULT_REF)
+    ap.add_argument("--check", action="store_true")
+    ap.add_argument("--sources", action="store_true")
+    a = ap.parse_args()
+    if a.sources:
+        for copy in ("exl3_linear.cu", "exl3_experts.cu", "exl3_experts_cb2.cu"):
+            print(copy, "base", a.src, a.ref)
+        return 0
+    stale = []
+    for name, text in outputs(a.src, a.ref).items():
+        path = HERE / name
+        if a.check:
+            if not path.exists() or path.read_text() != text:
+                stale.append(name)
+        else:
+            path.write_text(text)
+            print("wrote", path.name, len(text.splitlines()), "lines")
+    if stale:
+        print("stale:", ", ".join(stale), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
