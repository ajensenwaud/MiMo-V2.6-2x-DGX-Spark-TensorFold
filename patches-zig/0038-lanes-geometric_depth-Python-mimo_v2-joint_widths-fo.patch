From 178fe5feb283dd2f9cf43213c30a7ad33d95a31c Mon Sep 17 00:00:00 2001
From: Anders Jensen-Waud <anders@jensenwaud.com>
Date: Sun, 11 Oct 2026 22:14:59 +1100
Subject: [PATCH 38/43] lanes: geometric_depth (Python mimo_v2 joint_widths for
 a lone stream: one acceptance, draft pass charged once); mimo:
 TF_MIMO_DEPTH=geometric

---
 zig/src/core/lanes/config.zig       |  6 +++++
 zig/src/core/lanes/depth.zig        | 35 +++++++++++++++++++++++++++++
 zig/src/core/lanes/engine.zig       |  1 +
 zig/src/families/mimo_v2/native.zig |  2 ++
 4 files changed, 44 insertions(+)

diff --git a/zig/src/core/lanes/config.zig b/zig/src/core/lanes/config.zig
index a5256382..cb32b78b 100644
--- a/zig/src/core/lanes/config.zig
+++ b/zig/src/core/lanes/config.zig
@@ -32,6 +32,10 @@ pub const Model = struct {
     draft_streams: bool = false, // the head drafts every stream of a shared round in one batch
     head_trees: bool = false, // the head drafts trees of lanes (DraftRequest.lanes) and holds them
     lane_costs: []const Cost = &.{}, // a lone stream's window ms by rows, up to its widest tree (timed at load)
+    /// A lone stream's depth by one acceptance a stream (moving average 0.7 / 0.3 of kept / tried), a geometric chain
+    /// chance and a draft pass charged once whatever its depth (Python mimo_v2 decoder.joint_widths, for a DFlash-style
+    /// head that drafts its whole block in one pass); off: the per-depth rule with probes (depth.zig).
+    geometric_depth: bool = false,
 };
 
 pub const Config = struct {
@@ -61,6 +65,7 @@ pub const Config = struct {
     shared_costs: Table,
     lane_costs: Table, // window ms by rows to 64 (lanes/plan_lanes.zig)
     mtp_step_ms: f64,
+    geometric_depth: bool = false,
     enter_match: i64 = 8, // matching tokens a copy needs (rejects coincidental indentation)
     copy_rate: f64 = 0.94, // a copied token's chance of landing in allocation
     k: Constants = .{},
@@ -116,6 +121,7 @@ pub const Config = struct {
             .shared_costs = try alloc.extendCosts(gpa, timed.items, batch_rows),
             .lane_costs = try alloc.extendCosts(gpa, m.lane_costs, 64),
             .mtp_step_ms = m.mtp_step_ms,
+            .geometric_depth = m.geometric_depth,
         };
     }
 
diff --git a/zig/src/core/lanes/depth.zig b/zig/src/core/lanes/depth.zig
index 015136a0..590e6718 100644
--- a/zig/src/core/lanes/depth.zig
+++ b/zig/src/core/lanes/depth.zig
@@ -56,6 +56,7 @@ pub const Rule = struct {
     plain_guard: bool,
     node_probabilities: bool,
     batch_rows: u32,
+    geometric: bool = false, // Config.geometric_depth: p[0] is the stream's one acceptance (Python joint_widths)
     round_ms: Table = .{}, // a round's wall time by drafts, shared by every stream
     overhead: std.ArrayList(Overhead) = .empty, // a shared round's ms past its forward, by streams (insertion order)
 
@@ -68,6 +69,7 @@ pub const Rule = struct {
         if (who.state.* == null) {
             const n = @min(r.prior.len, @max(1, r.most_drafts));
             who.state.* = .{ .p = try r.gpa.dupe(f64, r.prior[0..n]) };
+            if (r.geometric) who.state.*.?.p[0] = 0.6; // decoder.py: alpha.setdefault(sid, 0.6)
         }
         return who.state.*.?.p;
     }
@@ -75,6 +77,13 @@ pub const Rule = struct {
     /// Draft j was tried when drafts 1 .. j - 1 were kept; its estimate moves toward whether it was kept.
     pub fn observeDepth(r: *Rule, who: Who, proposed: i64, accepted: i64) !void {
         const p = try r.rates(who);
+        if (r.geometric) {
+            if (proposed <= 0) return;
+            const got = @min(@max(accepted, 0), proposed);
+            const tried = got + @intFromBool(got < proposed);
+            p[0] = 0.7 * p[0] + 0.3 * (@as(f64, @floatFromInt(got)) / @as(f64, @floatFromInt(tried)));
+            return;
+        }
         const n = @min(@max(proposed, 0), @as(i64, @intCast(p.len)));
         var j: i64 = 0;
         while (j < n) : (j += 1) {
@@ -108,6 +117,7 @@ pub const Rule = struct {
         const table = try r.costs(who);
         if (table.get(drafts)) |v| return v;
         const forward = r.family_costs.get(drafts + 1) orelse return null;
+        if (r.geometric) return forward + (if (drafts > 0) r.mtp_step_ms else 0.0); // one draft pass, any depth
         var modeled = forward + r.mtp_step_ms * @as(f64, @floatFromInt(drafts));
         if (r.plain_guard) {
             // untimed: its model plus the least time a row of a timed round took beyond its model
@@ -129,6 +139,7 @@ pub const Rule = struct {
         const most = @min(@as(i64, r.most_drafts), @max(1, who.draft_room - 1));
         if (most <= 0) return 0;
         const p = try r.rates(who);
+        if (r.geometric and !r.family_costs.empty()) return r.geometricDepth(who, p[0], most);
         if (r.family_costs.empty()) {
             const want: i64 = if (p[0] < 0.8) 1 else if (p[0] < 0.9) 2 else 3;
             return @max(1, @min(most, want));
@@ -165,6 +176,30 @@ pub const Rule = struct {
         return best;
     }
 
+    /// decoder.joint_widths for one stream: the depth (0 .. most) with the most expected tokens (1 + a + a^2 + ...) a ms
+    /// of its round; a stream that stopped drafting re-checks with one draft every 8 rounds (decoder.PROBE).
+    fn geometricDepth(r: *Rule, who: Who, alpha: f64, most: i64) !i64 {
+        var best: i64 = 0;
+        var best_rate: f64 = -1.0;
+        var expected: f64 = 0.0;
+        var run: f64 = 1.0;
+        var d: i64 = 0;
+        while (d <= most) : (d += 1) {
+            expected += run;
+            run *= alpha;
+            const cost = (try r.roundCost(d, who)) orelse break;
+            if (cost <= 0.0) continue;
+            if (expected / cost > best_rate) {
+                best = d;
+                best_rate = expected / cost;
+            }
+        }
+        const st = &who.state.*.?;
+        st.rounds += 1;
+        if (best == 0 and st.rounds % 8 == 0) return @min(1, most);
+        return best;
+    }
+
     /// One draft after `wait` plain rounds in a row; each probe doubles the wait until drafting wins again.
     fn probePlain(r: *Rule, st: *State) bool {
         st.plain = (st.plain orelse 0) + 1;
diff --git a/zig/src/core/lanes/engine.zig b/zig/src/core/lanes/engine.zig
index b752d84e..01716da7 100644
--- a/zig/src/core/lanes/engine.zig
+++ b/zig/src/core/lanes/engine.zig
@@ -58,6 +58,7 @@ pub const Engine = struct {
                 .plain_guard = cfg.plain_guard,
                 .node_probabilities = cfg.node_probabilities,
                 .batch_rows = cfg.batch_rows,
+                .geometric = cfg.geometric_depth,
             },
         };
     }
diff --git a/zig/src/families/mimo_v2/native.zig b/zig/src/families/mimo_v2/native.zig
index aec7de40..3b855613 100644
--- a/zig/src/families/mimo_v2/native.zig
+++ b/zig/src/families/mimo_v2/native.zig
@@ -245,6 +245,8 @@ pub const Lanes = struct {
             .max_streams = @intCast(l.e.model.slots),
             .shared_costs = l.shared[0..l.nshared],
             .draft_streams = true,
+            // TF_MIMO_DEPTH=geometric: Python's joint_widths rule for a lone stream (off by default until measured)
+            .geometric_depth = if (std.c.getenv("TF_MIMO_DEPTH")) |v| std.mem.eql(u8, std.mem.span(v), "geometric") else false,
         };
     }
 
