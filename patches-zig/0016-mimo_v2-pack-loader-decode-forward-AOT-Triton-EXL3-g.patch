+++ b/zig/src/cuda/kernels.zig
@@ -34,6 +34,7 @@ pub const torch_nemotron_constants: []const u8 = if (available) &Blob("fatbin_to
 pub const mimo_exl3_linear: []const u8 = if (available) &Blob("fatbin_mimo_exl3_linear").bytes else &.{};
