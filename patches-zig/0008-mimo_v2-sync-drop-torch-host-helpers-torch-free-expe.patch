-}
-
 }  // namespace tf_exl3_linear
 
 // Every instantiation exl3_linear_cuda / exl3_unpack_cuda can launch (TF_EXL3_ALL, copied from the binding):
diff --git a/zig/kernels/cuda/mimo_v2/experts_grouped.cuh b/zig/kernels/cuda/mimo_v2/experts_grouped.cuh
index f65a51aa..668bbab8 100644
--- a/zig/kernels/cuda/mimo_v2/experts_grouped.cuh
+++ b/zig/kernels/cuda/mimo_v2/experts_grouped.cuh
@@ -1,13 +1,14 @@
-// Device code of cuda/exl3/experts_grouped.cuh (git blob 57be4c027785 at f3a8c11); verbatim.
+// Device code of cuda/exl3/experts_grouped.cuh (git blob 57be4c027785 at f3a8c11); torch includes swapped, device code verbatim.
 // Generated by zig/kernels/cuda/mimo_v2/sync.py. Do not edit: change the Python source and regenerate.
 // Grouped EXL3 expert GEMV (after ExLlamaV3, MIT, Copyright (c) 2025 Turboderp): rows stay independent, K ranges fixed by shape, warps summed in order.
 #pragma once
 
 #include <cuda_fp16.h>
 #include <cuda_bf16.h>
-#include <ATen/ATen.h>
-#include <ATen/cuda/CUDAContext.h>
-#include <c10/cuda/CUDAGuard.h>
+#include <cstdint>  // what the cut torch includes provided: the fixed-width integers
+#ifndef TORCH_CHECK
+#define TORCH_CHECK(...) ((void)0)  // host launch checks; the fatbin keeps device code only
+#endif
 
 namespace tf_exl3x {
 
diff --git a/zig/kernels/cuda/mimo_v2/sync.py b/zig/kernels/cuda/mimo_v2/sync.py
index b839a261..711c4339 100644
--- a/zig/kernels/cuda/mimo_v2/sync.py
+++ b/zig/kernels/cuda/mimo_v2/sync.py
@@ -63,7 +63,43 @@ def cut_device(text: str, ns: str) -> str:
         raise SystemExit(f"expected one anonymous namespace, found {len(opens)} opens / {len(closes)} closes")
     text = text[: closes[0]]
     text = text.replace("namespace {", f"namespace {ns} {{", 1).replace("}  // namespace", f"}}  // namespace {ns}", 1)
-    return text + "\n"
+    return drop_torch_helpers(text) + "\n"
+
+
+def drop_torch_helpers(text: str) -> str:
+    """Removes host helpers inside the device part that take torch types (e.g. linear.cu's dtype_of): a top-level
+    function whose signature names at:: or c10::, through its closing brace at column 0, plus one blank line."""
+    out, skip = [], False
+    for line in text.splitlines():
+        if not skip and re.match(r"^[A-Za-z_].*\(.*\b(at|c10)::", line) and "__global__" not in line:
+            skip = True
+        if skip:
+            if line.startswith("}"):
+                skip = False
+            continue
+        out.append(line)
+    text = "\n".join(out)
+    if re.search(r"\b(at|c10)::|TORCH_CHECK", text):
+        raise SystemExit("torch references left in the device part")
+    return re.sub(r"\n{3,}", "\n\n", text)
+
+
+def no_torch_header(src: Path, ref: str, name: str) -> str:
+    """A header whose host launchers use TORCH_CHECK: torch includes swapped for <cstdint>, TORCH_CHECK a no-op
+    (host code; a fatbin keeps device code only). Device code verbatim."""
+    rel = f"{X}/{name}"
+    lines, swapped = [], False
+    for line in show(src, ref, rel).splitlines():
+        if line.strip() in TORCH_INCLUDES:
+            if not swapped:
+                lines.append("#include <cstdint>  // what the cut torch includes provided: the fixed-width integers")
+                lines.append("#ifndef TORCH_CHECK")
+                lines.append("#define TORCH_CHECK(...) ((void)0)  // host launch checks; the fatbin keeps device code only")
+                lines.append("#endif")
+                swapped = True
+            continue
+        lines.append(line)
+    return header(src, ref, rel, "torch includes swapped, device code verbatim.") + "\n".join(lines) + "\n"
 
 
 def macro(text: str, name: str) -> str:
@@ -110,7 +146,7 @@ def verbatim(src: Path, ref: str, name: str) -> str:
 def outputs(src: Path, ref: str) -> dict[str, str]:
     return {
         "decode.cuh": verbatim(src, ref, "decode.cuh"),
-        "experts_grouped.cuh": verbatim(src, ref, "experts_grouped.cuh"),
+        "experts_grouped.cuh": no_torch_header(src, ref, "experts_grouped.cuh"),
         # experts_cb2.cu instantiates grouped_launch<2> / dequant_launch<2>: mul1, the codebook MiMo's packs use
         "exl3_experts_cb2.cu": verbatim(src, ref, "experts_cb2.cu"),
         "exl3_linear.cu": linear(src, ref),
