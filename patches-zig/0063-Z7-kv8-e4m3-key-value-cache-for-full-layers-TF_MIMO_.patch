+    const f_quant = try mod.function("mimo_kv8_quant");
+    const f_rows8 = try mod.function("mimo_rows8");
+    const f_dq = try mod.function("mimo_kv8_dequant");
+    const k16 = try ar.zeros(ent * 192 * 2);
+    const v16 = try ar.zeros(ent * 128 * 2);
+    const kc8 = try ar.zeros(ent * 192);
+    const vc8 = try ar.zeros(ent * 128);
+    const ks = try ar.zeros(ent * 4);
+    const vs = try ar.zeros(ent * 4);
+    const kd = try ar.zeros(ent * 192 * 2);
+    const vd = try ar.zeros(ent * 128 * 2);
+    const q = try ar.zeros(8 * H * 192 * 2);
+    const po = try ar.zeros(8 * NCH * H * 128 * 4);
+    const pm = try ar.zeros(8 * NCH * H * 4);
+    const pl = try ar.zeros(8 * NCH * H * 4);
+    const outs = [3]u64{ try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2) };
+    const grid1k: cuda.launch.Config = .{ .grid = .{ .x = 1024, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } };
+    inline for (.{ .{ k16, ent * 192, 1, 1.0 }, .{ v16, ent * 128, 2, 1.0 }, .{ q, 8 * H * 192, 3, 3.0 } }) |f| {
+        var a: cuda.Args = .{};
+        a.add(f[0]);
+        a.add(@as(i64, @intCast(f[1])));
+        a.add(@as(u32, f[2]));
+        a.add(@as(f32, f[3]));
+        try cuda.launch.launch(f_fill, grid1k, s, &a);
+    }
+    {
+        var a: cuda.Args = .{};
+        inline for (.{ k16, v16, kc8, ks, vc8, vs }) |x| a.add(x);
+        try cuda.launch.launch(f_quant, .{ .grid = .{ .x = u(ent), .y = 1, .z = 1 }, .block = .{ .x = 32, .y = 1, .z = 1 } }, s, &a);
+    }
+    {
+        var a: cuda.Args = .{};
+        inline for (.{ kc8, ks, vc8, vs, kd, vd }) |x| a.add(x);
+        a.add(@as(i64, 0));
+        a.add(@as(c_int, @intCast(LEN)));
+        a.add(@as(c_int, @intCast(HK)));
+        try cuda.launch.launch(f_dq, grid1k, s, &a);
+    }
+    const host = try m.gpa.alloc(u16, 3 * 8 * H * 128);
+    defer m.gpa.free(host);
+    for ([_]usize{ 1, 4, 8 }) |n| {
+        var hp: [8]i32 = undefined;
+        var hs: [8]i32 = undefined;
+        for (0..n) |j| {
+            hp[j] = @intCast(P + j);
+            hs[j] = 0;
+        }
+        const pos = try ar.upload(std.mem.sliceAsBytes(hp[0..n]));
+        const slot = try ar.upload(std.mem.sliceAsBytes(hs[0..n]));
+        const Run = struct {
+            fn triton(mm: *Model, ss: Stream, qq: u64, kk: u64, vv: u64, ps: u64, sl: u64, bufs: [3]u64, out: u64, rows: usize, h: usize, hk: usize, g: usize, len: usize, nch: usize) !void {
+                try mm.set.run(ss, "_rows", .{ u(rows), u(hk), u(nch) }, &.{
+                    p("Q", "*fp16", qq),  p("KC", "*fp16", kk),     p("VC", "*fp16", vv),
+                    p("POS", "*i32", ps), p("SLOT", "*i32", sl),    p("PO", "*fp32", bufs[0]),
+                    p("PM", "*fp32", bufs[1]), p("PL", "*fp32", bufs[2]), ii("LEN", len),
+                    ii("NCH", nch),
+                }, &.{ ci("H", h), ci("HK", hk), ci("G", g), ci("WIN", 0), aot.cf("SCALE", mm.scale), ci("CK", CK), ci("BN", BN), ci("GP", GP) });
+                try merge(mm, ss, bufs, out, rows, h, nch);
+            }
+            fn merge(mm: *Model, ss: Stream, bufs: [3]u64, out: u64, rows: usize, h: usize, nch: usize) !void {
+                try mm.set.run(ss, "_merge", .{ u(rows), u(h), 1 }, &.{
+                    p("PO", "*fp32", bufs[0]), p("PM", "*fp32", bufs[1]), p("PL", "*fp32", bufs[2]),
+                    p("SINKS", "*fp32", bufs[1]), p("OUT", "*fp16", out), ii("NCH", nch),
+                }, &.{ ci("H", h), ci("HAS_SINK", 0) });
+            }
+        };
+        const bufs = [3]u64{ po, pm, pl };
+        const rows8 = struct {
+            fn go(mm: *Model, ss: Stream, f: cuda.Function, qq: u64, c8: [4]u64, ps: u64, sl: u64, b: [3]u64, out: u64, rows: usize, h: usize, hk: usize, len: usize, nch: usize) !void {
+                var a: cuda.Args = .{};
+                inline for (.{ qq, c8[0], c8[1], c8[2], c8[3], ps, sl, b[0], b[1], b[2] }) |x| a.add(x);
+                a.add(@as(c_int, @intCast(len)));
+                a.add(@as(c_int, @intCast(nch)));
+                a.add(@as(c_int, @intCast(h)));
+                a.add(@as(c_int, @intCast(hk)));
+                a.add(mm.scale);
+                try cuda.launch.launch(f, .{ .grid = .{ .x = u(rows), .y = u(hk), .z = u(nch) }, .block = .{ .x = 128, .y = 1, .z = 1 } }, ss, &a);
+                try Run.merge(mm, ss, b, out, rows, h, nch);
+            }
+        };
+        const c8 = [4]u64{ kc8, ks, vc8, vs };
+        try Run.triton(m, s, q, kd, vd, pos, slot, bufs, outs[0], n, H, HK, G, LEN, NCH);
+        try Run.triton(m, s, q, k16, v16, pos, slot, bufs, outs[1], n, H, HK, G, LEN, NCH);
+        try rows8.go(m, s, f_rows8, q, c8, pos, slot, bufs, outs[2], n, H, HK, LEN, NCH);
+        try s.synchronize();
+        const per = n * H * 128;
+        for (0..3) |k| try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(host[k * per ..].ptr), outs[k], per * 2), "kv8check download");
+        var e_k: f64 = 0; // rows8 vs Triton on the same 8-bit values
+        var e_q: f64 = 0; // rows8 vs Triton on fp16 (quantisation)
+        var e_qm: f64 = 0;
+        var amax: f64 = 0;
+        var bad: usize = 0;
+        for (0..per) |i| {
+            const ref: f64 = @floatCast(@as(f16, @bitCast(host[i])));
+            const r16: f64 = @floatCast(@as(f16, @bitCast(host[per + i])));
+            const got: f64 = @floatCast(@as(f16, @bitCast(host[2 * per + i])));
+            if (!std.math.isFinite(got)) bad += 1;
+            e_k = @max(e_k, @abs(got - ref));
+            e_q = @max(e_q, @abs(got - r16));
+            e_qm += @abs(got - r16);
+            amax = @max(amax, @abs(r16));
+        }
+        // time: 20 reps each
+        var t_tri: f64 = 0;
+        var t_8: f64 = 0;
+        for (0..2) |phase| {
+            const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            for (0..20) |_| {
+                if (phase == 0) try Run.triton(m, s, q, k16, v16, pos, slot, bufs, outs[1], n, H, HK, G, LEN, NCH) else try rows8.go(m, s, f_rows8, q, c8, pos, slot, bufs, outs[2], n, H, HK, LEN, NCH);
+            }
+            try s.synchronize();
+            const ms = @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds() - t0)) / 1e6 / 20.0;
+            if (phase == 0) t_tri = ms else t_8 = ms;
+        }
+        std.debug.print("[kv8check] rank {d}: {d} rows at {d}: max |rows8 - triton(same 8-bit)| {e:.3}, max |rows8 - triton(fp16)| {e:.3} (mean {e:.3}, |out| max {d:.3}), non-finite {d}; a layer's attention triton fp16 {d:.3} ms, rows8 {d:.3} ms\n", .{ rank, n, P, e_k, e_q, e_qm / @as(f64, @floatFromInt(per)), amax, bad, t_tri, t_8 });
+    }
+}
