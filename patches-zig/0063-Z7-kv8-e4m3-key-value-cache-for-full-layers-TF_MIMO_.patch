+/// tf-mimo kv8check: the 8-bit decode attention (kv8.cu) against the Triton kernels on one stream's 131,136-key
+/// cache of hashed values: rows at 128,000.. (1, 4, 8 rows). Errors against the Triton kernel on the same 8-bit values
+/// (dequantised to fp16: the kernel's own error) and on the fp16 values (the cache's quantisation error); then the
+/// time of each (rows + merge, 20 reps).
+pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
+    const cfg = m.w.cfg;
+    const H = cfg.heads;
+    const HK = cfg.kv_full;
+    const G = H / HK;
+    const LEN: usize = 131072 + 64;
+    const NCH: usize = 131072 / CK;
+    const P: usize = 128000;
