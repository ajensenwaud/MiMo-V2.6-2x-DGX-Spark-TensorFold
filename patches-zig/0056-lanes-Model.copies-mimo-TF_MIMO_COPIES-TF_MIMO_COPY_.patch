From b549845e24c7c36bcd01b5af862b1c0d6c2ef7b8 Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 12 Oct 2026 09:07:55 +1100
Subject: [PATCH 56/71] lanes: Model.copies; mimo: TF_MIMO_COPIES,
 TF_MIMO_COPY_ROWS

---
 zig/src/core/lanes/config.zig       | 3 ++-
 zig/src/families/mimo_v2/native.zig | 4 ++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/zig/src/core/lanes/config.zig b/zig/src/core/lanes/config.zig
index 1f26aafd..134c459c 100644
--- a/zig/src/core/lanes/config.zig
+++ b/zig/src/core/lanes/config.zig
@@ -14,6 +14,7 @@ pub const default_prior = [_]f64{ 0.85, 0.75, 0.7, 0.65, 0.6, 0.55, 0.5, 0.5, 0.
 pub const Model = struct {
     exact_width: u32 = 1, // the widest window that reproduces one-token steps bit for bit
     first_copy_rows: u32 = 0, // a lone stream's first copy window (0: the exact width)
+    copies: bool = true, // suffix-match copy windows (Python's CopyIndex); off: drafts only
     gpu_tokens: bool = false, // one-token rounds may run a step ahead (pipelined)
     mtp: bool = false, // a draft head is loaded
     speculate: bool = false, // the head can draft from a verify's rows
@@ -79,7 +80,7 @@ pub const Config = struct {
     pub fn init(gpa: Allocator, m: Model, max_rows: u32, max_draft: u32) !Config {
         if (max_rows < 1) return error.BadMaxRows;
         const width: u32 = @max(1, @min(@max(m.exact_width, 1), max_rows));
-        const max_copy = width - 1;
+        const max_copy = if (m.copies) width - 1 else 0;
         const first_rows: i64 = if (m.first_copy_rows != 0) m.first_copy_rows else width;
         const first_copy: u32 = @intCast(@max(1, @min(@as(i64, max_copy), first_rows - 1)));
         const prior = if (m.draft_prior.len > 0) m.draft_prior else &default_prior;
diff --git a/zig/src/families/mimo_v2/native.zig b/zig/src/families/mimo_v2/native.zig
index b33288e6..28ea572b 100644
--- a/zig/src/families/mimo_v2/native.zig
+++ b/zig/src/families/mimo_v2/native.zig
@@ -291,6 +291,10 @@ pub const Lanes = struct {
             .geometric_depth = !depthIs("lanes"),
             .geometric_costs = if (depthIs("geometric")) &.{} else &python_grid1,
             .geometric_draft_cost = 0.25,
+            // copy windows (suffix matches of 8+ tokens): TF_MIMO_COPIES=0 off (Python's DFlash decoder never copies),
+            // TF_MIMO_COPY_ROWS the first window's rows (default: the drafter's block)
+            .copies = if (std.c.getenv("TF_MIMO_COPIES")) |v| v[0] != '0' else true,
+            .first_copy_rows = if (std.c.getenv("TF_MIMO_COPY_ROWS")) |v| std.fmt.parseInt(u32, std.mem.span(v), 10) catch 0 else 0,
         };
     }
 
