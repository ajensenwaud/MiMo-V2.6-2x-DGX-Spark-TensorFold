From 41302333cc3f02d7de572235a1e86893ae65ca94 Mon Sep 17 00:00:00 2001
From: Anders Jensen-Waud <anders@jensenwaud.com>
Date: Mon, 12 Oct 2026 11:51:46 +1100
Subject: [PATCH 64/67] kv8: module unload takes a mutable module

---
 zig/src/families/mimo_v2/forward.zig | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/zig/src/families/mimo_v2/forward.zig b/zig/src/families/mimo_v2/forward.zig
index 2cfccdb7..e4063c4c 100644
--- a/zig/src/families/mimo_v2/forward.zig
+++ b/zig/src/families/mimo_v2/forward.zig
@@ -286,7 +286,7 @@ pub const Model = struct {
         m.gpa.free(m.vc);
         m.gpa.free(m.ks);
         m.gpa.free(m.vs);
-        if (m.kv8_mod) |k| k.unload();
+        if (m.kv8_mod) |*k| k.unload();
         m.glue.unload();
         m.arena.deinit();
     }
@@ -607,7 +607,7 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
     const P: usize = 128000;
     const ent = LEN * HK;
     const ar = &m.arena;
-    const mod = try cuda.Module.load(m.d, cuda.kernels.mimo_kv8);
+    var mod = try cuda.Module.load(m.d, cuda.kernels.mimo_kv8);
     defer mod.unload();
     const f_fill = try mod.function("mimo_fill_half");
     const f_quant = try mod.function("mimo_kv8_quant");
-- 
2.53.0

