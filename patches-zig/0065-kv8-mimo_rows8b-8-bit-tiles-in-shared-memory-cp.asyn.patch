From e6aa5eaef12be644c37d0ce1a65d5d519f40bfce Mon Sep 17 00:00:00 2001
From: ajensenwaud <ajensenwaud@users.noreply.github.com>
Date: Mon, 12 Oct 2026 12:07:42 +1100
Subject: [PATCH 65/71] kv8: mimo_rows8b (8-bit tiles in shared memory,
 cp.async two stages, scales on scores / probabilities); kv8check times both

---
 zig/kernels/cuda/mimo_v2/kv8.cu      | 187 +++++++++++++++++++++++++++
 zig/src/families/mimo_v2/forward.zig |  25 ++--
 2 files changed, 204 insertions(+), 8 deletions(-)

diff --git a/zig/kernels/cuda/mimo_v2/kv8.cu b/zig/kernels/cuda/mimo_v2/kv8.cu
index 26ec4f4c..37af74cb 100644
--- a/zig/kernels/cuda/mimo_v2/kv8.cu
+++ b/zig/kernels/cuda/mimo_v2/kv8.cu
@@ -310,6 +310,193 @@ extern "C" __global__ void __launch_bounds__(128) mimo_rows8(
     }
 }
 
+// mimo_rows8b: mimo_rows8 with the 8-bit tiles left 8-bit in shared memory, two stages in flight (cp.async):
+// fragments convert e4m3 pairs on the fly; a key's scale multiplies its score (keys) and its probability (values).
+namespace mimo_kv8 {
+constexpr int KROW = D + 16, VROW = DV + 16; // padded rows (bytes): fewer bank conflicts on the pair reads
+constexpr int STAGE = BN * KROW + BN * VROW + 2 * BN * 4;
+
+__device__ __forceinline__ void cp16z(void* dst, const void* src, bool in) {
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16, %2;\n" ::"r"(smem(dst)), "l"(src), "r"(in ? 16 : 0));
+}
+__device__ __forceinline__ void cp4z(void* dst, const void* src, bool in) {
+    asm volatile("cp.async.ca.shared.global [%0], [%1], 4, %2;\n" ::"r"(smem(dst)), "l"(src), "r"(in ? 4 : 0));
+}
+__device__ __forceinline__ void commit() { asm volatile("cp.async.commit_group;\n" ::); }
+template <int N>
+__device__ __forceinline__ void wait_group() { asm volatile("cp.async.wait_group %0;\n" ::"n"(N)); }
+
+__device__ __forceinline__ uint32_t cvt2(uint16_t pair) {
+    const __half2_raw h = __nv_cvt_fp8x2_to_halfraw2(static_cast<__nv_fp8x2_storage_t>(pair), __NV_E4M3);
+    return *reinterpret_cast<const uint32_t*>(&h);
+}
+} // namespace mimo_kv8
+
+extern "C" __global__ void __launch_bounds__(128) mimo_rows8b(
+    const __half* __restrict__ Q, const uint8_t* __restrict__ KC, const float* __restrict__ KS,
+    const uint8_t* __restrict__ VC, const float* __restrict__ VS, const int32_t* __restrict__ POS,
+    const int32_t* __restrict__ SLOT, float* __restrict__ PO, float* __restrict__ PM, float* __restrict__ PL, int LEN,
+    int NCH, int H, int HK, float scale) {
+    __shared__ __align__(16) uint8_t st[2][STAGE];
+    const int r = blockIdx.x, hk = blockIdx.y, c = blockIdx.z, n = gridDim.x;
+    const int slot = SLOT[r];
+    if (r % 4 != 0 && SLOT[r - 1] == slot) return;
+    int R = 1;
+    while (R < 4 && r + R < n && (r + R) % 4 != 0 && SLOT[r + R] == slot) ++R;
+    const int warp = threadIdx.x / 32, lane = threadIdx.x % 32, g = lane / 4, qd = lane % 4;
+    const bool live = warp < R;
+    const int row = r + (live ? warp : 0);
+    const int pos = POS[row];
+    int maxpos = POS[r];
+    for (int i = 1; i < R; ++i) maxpos = max(maxpos, POS[r + i]);
+    const int start = c * CK;
+    const int64_t base = static_cast<int64_t>(slot) * LEN;
+    float o[DV / 8][4];
+#pragma unroll
+    for (int i = 0; i < DV / 8; ++i) o[i][0] = o[i][1] = o[i][2] = o[i][3] = 0.0f;
+    float m0 = -CUDART_INF_F, m1 = -CUDART_INF_F, l0 = 0.0f, l1 = 0.0f;
+    const int head0 = hk * G + g;
+    const int tiles = start <= maxpos ? min(CK / BN, (maxpos - start) / BN + 1) : 0;
+    auto stage = [&](int t) {
+        uint8_t* s = st[t & 1];
+        const int key0 = start + t * BN;
+        for (int i = threadIdx.x; i < BN * (D / 16); i += blockDim.x) {
+            const int key = i / (D / 16), cc = i % (D / 16), kidx = key0 + key;
+            const bool in = kidx <= maxpos;
+            cp16z(s + key * KROW + cc * 16, KC + ((base + (in ? kidx : 0)) * HK + hk) * D + cc * 16, in);
+        }
+        for (int i = threadIdx.x; i < BN * (DV / 16); i += blockDim.x) {
+            const int key = i / (DV / 16), cc = i % (DV / 16), kidx = key0 + key;
+            const bool in = kidx <= maxpos;
+            cp16z(s + BN * KROW + key * VROW + cc * 16, VC + ((base + (in ? kidx : 0)) * HK + hk) * DV + cc * 16, in);
+        }
+        for (int i = threadIdx.x; i < 2 * BN; i += blockDim.x) {
+            const int key = i % BN, kidx = key0 + key;
+            const bool in = kidx <= maxpos;
+            const float* src = (i < BN ? KS : VS) + (base + (in ? kidx : 0)) * HK + hk;
+            cp4z(s + BN * KROW + BN * VROW + i * 4, src, in);
+        }
+    };
+    uint32_t qa[D / 16][4];
+    if (tiles > 0) {
+        stage(0);
+        commit();
+        const uint32_t* q0 = reinterpret_cast<const uint32_t*>(Q + (static_cast<int64_t>(row) * H + head0) * D);
+        const uint32_t* q1 = q0 + 8 * D / 2;
+#pragma unroll
+        for (int k = 0; k < D / 16; ++k) {
+            qa[k][0] = q0[8 * k + qd];
+            qa[k][1] = q1[8 * k + qd];
+            qa[k][2] = q0[8 * k + qd + 4];
+            qa[k][3] = q1[8 * k + qd + 4];
+        }
+    }
+    for (int t = 0; t < tiles; ++t) {
+        if (t + 1 < tiles) stage(t + 1);
+        commit();
+        wait_group<1>();
+        __syncthreads();
+        const uint8_t* s = st[t & 1];
+        const uint8_t* ks8 = s;
+        const uint8_t* vs8 = s + BN * KROW;
+        const float* ksc = reinterpret_cast<const float*>(s + BN * KROW + BN * VROW);
+        const float* vsc = ksc + BN;
+        const int key0 = start + t * BN;
+        if (live && key0 <= pos) {
+            float sc[8][4];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) sc[i][0] = sc[i][1] = sc[i][2] = sc[i][3] = 0.0f;
+#pragma unroll
+            for (int k = 0; k < D / 16; ++k) {
+#pragma unroll
+                for (int nn = 0; nn < 8; ++nn) {
+                    const uint8_t* kr = ks8 + (8 * nn + g) * KROW + 16 * k + 2 * qd;
+                    mma(sc[nn], qa[k], cvt2(*reinterpret_cast<const uint16_t*>(kr)),
+                        cvt2(*reinterpret_cast<const uint16_t*>(kr + 8)));
+                }
+            }
+            const int kb = 2 * qd;
+            float tm0 = -CUDART_INF_F, tm1 = -CUDART_INF_F;
+#pragma unroll
+            for (int nn = 0; nn < 8; ++nn) {
+                const int kk = kb + 8 * nn, cidx = key0 + kk;
+                const float s0 = ksc[kk] * scale, s1 = ksc[kk + 1] * scale;
+                sc[nn][0] = cidx <= pos ? sc[nn][0] * s0 : -CUDART_INF_F;
+                sc[nn][1] = cidx + 1 <= pos ? sc[nn][1] * s1 : -CUDART_INF_F;
+                sc[nn][2] = cidx <= pos ? sc[nn][2] * s0 : -CUDART_INF_F;
+                sc[nn][3] = cidx + 1 <= pos ? sc[nn][3] * s1 : -CUDART_INF_F;
+                tm0 = fmaxf(tm0, fmaxf(sc[nn][0], sc[nn][1]));
+                tm1 = fmaxf(tm1, fmaxf(sc[nn][2], sc[nn][3]));
+            }
+            for (int x = 1; x <= 2; x *= 2) {
+                tm0 = fmaxf(tm0, __shfl_xor_sync(0xffffffffu, tm0, x));
+                tm1 = fmaxf(tm1, __shfl_xor_sync(0xffffffffu, tm1, x));
+            }
+            const float n0 = fmaxf(m0, tm0), n1 = fmaxf(m1, tm1);
+            const float a0 = m0 == -CUDART_INF_F ? 0.0f : texp(m0 - n0);
+            const float a1 = m1 == -CUDART_INF_F ? 0.0f : texp(m1 - n1);
+            float c0[8], c1[8];
+#pragma unroll
+            for (int nn = 0; nn < 8; ++nn) {
+                const int kk = kb + 8 * nn, cidx = key0 + kk;
+                sc[nn][0] = cidx <= pos ? texp(sc[nn][0] - n0) : 0.0f;
+                sc[nn][1] = cidx + 1 <= pos ? texp(sc[nn][1] - n0) : 0.0f;
+                sc[nn][2] = cidx <= pos ? texp(sc[nn][2] - n1) : 0.0f;
+                sc[nn][3] = cidx + 1 <= pos ? texp(sc[nn][3] - n1) : 0.0f;
+                c0[nn] = sc[nn][0] + sc[nn][1];
+                c1[nn] = sc[nn][2] + sc[nn][3];
+                // the value scale rides on the probability: p v = (p s_v) v8
+                const float v0 = vsc[kk], v1 = vsc[kk + 1];
+                sc[nn][0] *= v0;
+                sc[nn][1] *= v1;
+                sc[nn][2] *= v0;
+                sc[nn][3] *= v1;
+            }
+            l0 = l0 * a0 + rowsum(c0);
+            l1 = l1 * a1 + rowsum(c1);
+            m0 = n0;
+            m1 = n1;
+#pragma unroll
+            for (int i = 0; i < DV / 8; ++i) {
+                o[i][0] *= a0;
+                o[i][1] *= a0;
+                o[i][2] *= a1;
+                o[i][3] *= a1;
+            }
+#pragma unroll
+            for (int j = 0; j < 4; ++j) {
+                const uint32_t pa[4] = {pack(sc[2 * j][0], sc[2 * j][1]), pack(sc[2 * j][2], sc[2 * j][3]),
+                                        pack(sc[2 * j + 1][0], sc[2 * j + 1][1]),
+                                        pack(sc[2 * j + 1][2], sc[2 * j + 1][3])};
+                const uint8_t* v0r = vs8 + (16 * j + 2 * qd) * VROW;
+#pragma unroll
+                for (int i = 0; i < DV / 8; ++i) {
+                    const int dcol = 8 * i + g;
+                    const uint16_t lo = static_cast<uint16_t>(v0r[dcol]) | (static_cast<uint16_t>(v0r[VROW + dcol]) << 8);
+                    const uint16_t hi = static_cast<uint16_t>(v0r[8 * VROW + dcol]) |
+                                        (static_cast<uint16_t>(v0r[9 * VROW + dcol]) << 8);
+                    mma(o[i], pa, cvt2(lo), cvt2(hi));
+                }
+            }
+        }
+        __syncthreads(); // the stage is read: the next iteration's copy may overwrite it
+    }
+    if (!live) return;
+    const int64_t part0 = (static_cast<int64_t>(row) * NCH + c) * H + head0, part1 = part0 + 8;
+    if (qd == 0) {
+        PM[part0] = m0;
+        PL[part0] = l0;
+        PM[part1] = m1;
+        PL[part1] = l1;
+    }
+#pragma unroll
+    for (int i = 0; i < DV / 8; ++i) {
+        const int d = 8 * i + 2 * qd;
+        *reinterpret_cast<float2*>(PO + part0 * DV + d) = make_float2(o[i][0], o[i][1]);
+        *reinterpret_cast<float2*>(PO + part1 * DV + d) = make_float2(o[i][2], o[i][3]);
+    }
+}
+
 // One stream's keys [0, keys): KC / VC rows at base + key -> KD [keys, HK, 192], VD [keys, HK, 128] fp16.
 extern "C" __global__ void mimo_kv8_dequant(const uint8_t* __restrict__ KC, const float* __restrict__ KS,
                                             const uint8_t* __restrict__ VC, const float* __restrict__ VS,
diff --git a/zig/src/families/mimo_v2/forward.zig b/zig/src/families/mimo_v2/forward.zig
index e4063c4c..e3f36ebf 100644
--- a/zig/src/families/mimo_v2/forward.zig
+++ b/zig/src/families/mimo_v2/forward.zig
@@ -182,7 +182,9 @@ pub const Model = struct {
         if (m.kv8) {
             m.kv8_mod = try cuda.Module.load(d, cuda.kernels.mimo_kv8);
             m.f_qkv8 = try m.kv8_mod.?.function("mimo_qkv8");
-            m.f_rows8 = try m.kv8_mod.?.function("mimo_rows8");
+            // TF_MIMO_KV8_KERNEL=a: keys dequantised into shared memory; b (default): 8-bit tiles, two stages in flight
+            const kb = if (std.c.getenv("TF_MIMO_KV8_KERNEL")) |v| v[0] != 'a' else true;
+            m.f_rows8 = try m.kv8_mod.?.function(if (kb) "mimo_rows8b" else "mimo_rows8");
             m.f_dq8 = try m.kv8_mod.?.function("mimo_kv8_dequant");
         }
         for (0..cfg.layers) |i| {
@@ -612,6 +614,7 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
     const f_fill = try mod.function("mimo_fill_half");
     const f_quant = try mod.function("mimo_kv8_quant");
     const f_rows8 = try mod.function("mimo_rows8");
+    const f_rows8b = try mod.function("mimo_rows8b");
     const f_dq = try mod.function("mimo_kv8_dequant");
     const k16 = try ar.zeros(ent * 192 * 2);
     const v16 = try ar.zeros(ent * 128 * 2);
@@ -625,7 +628,7 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
     const po = try ar.zeros(8 * NCH * H * 128 * 4);
     const pm = try ar.zeros(8 * NCH * H * 4);
     const pl = try ar.zeros(8 * NCH * H * 4);
-    const outs = [3]u64{ try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2) };
+    const outs = [4]u64{ try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2), try ar.zeros(8 * H * 128 * 2) };
     const grid1k: cuda.launch.Config = .{ .grid = .{ .x = 1024, .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } };
     inline for (.{ .{ k16, ent * 192, 1, 1.0 }, .{ v16, ent * 128, 2, 1.0 }, .{ q, 8 * H * 192, 3, 3.0 } }) |f| {
         var a: cuda.Args = .{};
@@ -648,7 +651,7 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
         a.add(@as(c_int, @intCast(HK)));
         try cuda.launch.launch(f_dq, grid1k, s, &a);
     }
-    const host = try m.gpa.alloc(u16, 3 * 8 * H * 128);
+    const host = try m.gpa.alloc(u16, 4 * 8 * H * 128);
     defer m.gpa.free(host);
     for ([_]usize{ 1, 4, 8 }) |n| {
         var hp: [8]i32 = undefined;
@@ -694,15 +697,20 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
         try Run.triton(m, s, q, kd, vd, pos, slot, bufs, outs[0], n, H, HK, G, LEN, NCH);
         try Run.triton(m, s, q, k16, v16, pos, slot, bufs, outs[1], n, H, HK, G, LEN, NCH);
         try rows8.go(m, s, f_rows8, q, c8, pos, slot, bufs, outs[2], n, H, HK, LEN, NCH);
+        try rows8.go(m, s, f_rows8b, q, c8, pos, slot, bufs, outs[3], n, H, HK, LEN, NCH);
         try s.synchronize();
         const per = n * H * 128;
-        for (0..3) |k| try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(host[k * per ..].ptr), outs[k], per * 2), "kv8check download");
+        for (0..4) |k| try m.d.check(m.d.api.cuMemcpyDtoH_v2(@ptrCast(host[k * per ..].ptr), outs[k], per * 2), "kv8check download");
         var e_k: f64 = 0; // rows8 vs Triton on the same 8-bit values
         var e_q: f64 = 0; // rows8 vs Triton on fp16 (quantisation)
         var e_qm: f64 = 0;
         var amax: f64 = 0;
         var bad: usize = 0;
+        var e_b: f64 = 0; // rows8b vs Triton on the same 8-bit values
         for (0..per) |i| {
+            const gb: f64 = @floatCast(@as(f16, @bitCast(host[3 * per + i])));
+            if (!std.math.isFinite(gb)) bad += 1;
+            e_b = @max(e_b, @abs(gb - @as(f64, @floatCast(@as(f16, @bitCast(host[i]))))));
             const ref: f64 = @floatCast(@as(f16, @bitCast(host[i])));
             const r16: f64 = @floatCast(@as(f16, @bitCast(host[per + i])));
             const got: f64 = @floatCast(@as(f16, @bitCast(host[2 * per + i])));
@@ -715,15 +723,16 @@ pub fn kv8Check(m: *Model, io: std.Io, s: Stream, rank: usize) !void {
         // time: 20 reps each
         var t_tri: f64 = 0;
         var t_8: f64 = 0;
