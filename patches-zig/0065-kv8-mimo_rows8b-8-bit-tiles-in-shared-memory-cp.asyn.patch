+                if (phase == 0) try Run.triton(m, s, q, k16, v16, pos, slot, bufs, outs[1], n, H, HK, G, LEN, NCH) else try rows8.go(m, s, if (phase == 1) f_rows8 else f_rows8b, q, c8, pos, slot, bufs, outs[2], n, H, HK, LEN, NCH);
