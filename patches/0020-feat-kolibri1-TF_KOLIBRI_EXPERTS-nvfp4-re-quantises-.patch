@@ -0,0 +1,59 @@
+"""Kolibri 1's FP8 experts re-quantised to NVFP4 at load (opt-in, quality-gated): half the expert bytes a token.
+
+Each 16-input block takes the e4m3 scale (of four candidates around amax / 6) with the least squared error against
+the checkpoint's own FP8 weights, so the 4-bit copy tracks the shipped numerics, not a bf16 ancestor."""
+
+from __future__ import annotations
+
+import torch
+
+from tensorfold.cuda.fp8 import experts as fp8x
+from tensorfold.cuda.nvfp4 import experts as nvx
+
+MAGS = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+CUTS = (0.25, 0.75, 1.25, 1.75, 2.5, 3.5, 5.0)          # midpoints between MAGS
+FACTORS = (1.0, 0.95, 0.9, 0.85)                        # candidate scale = factor * amax / 6
+
+
+def _nvfp4(w: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """fp32 [E, N, K] -> (words [E, N, K/2] uint8 low nibble first, e4m3 scale bytes [E, N, K/16], scales [E])."""
+
+    e, n, k = w.shape
+    blocks = w.view(e, n, k // 16, 16)
+    g = (w.abs().amax(dim=(1, 2)) / (6.0 * 448.0)).clamp_min(1e-30)               # [E]
+    gb = g.view(e, 1, 1, 1)
+    amax = blocks.abs().amax(-1, keepdim=True)
+    mags = torch.tensor(MAGS, device=w.device)
+    cuts = torch.tensor(CUTS, device=w.device)
+    best_err = best_s = best_i = None
+    for f in FACTORS:
+        s = (amax * f / 6.0 / gb).clamp(max=448.0).to(torch.float8_e4m3fn)
+        step = s.float() * gb
+        v = torch.where(step > 0, blocks / step.clamp_min(1e-30), torch.zeros_like(blocks))
+        i = torch.bucketize(v.abs().clamp(max=6.0), cuts)                         # nearest magnitude, 0..7
+        err = ((mags[i] * torch.sign(v) * step - blocks) ** 2).sum(-1, keepdim=True)
+        code = i + 8 * (v < 0).to(i.dtype)
+        if best_err is None:
+            best_err, best_s, best_i = err, s, code
+        else:
+            take = err < best_err
+            best_err = torch.where(take, err, best_err)
+            best_s = torch.where(take, s.view(torch.uint8), best_s.view(torch.uint8)).view(torch.float8_e4m3fn)
+            best_i = torch.where(take, code, best_i)
+    code = best_i.view(e, n, k).to(torch.uint8)
+    words = (code[..., 0::2] | (code[..., 1::2] << 4)).contiguous()
+    return words, best_s.view(e, n, k // 16).view(torch.uint8).contiguous(), g
+
+
+def from_fp8(weight: torch.Tensor, scale: torch.Tensor, chunk: int = 8):
+    """FP8 [E, N, K] with 128 x 128 fp32 scales -> an NVFP4 triple for ``nvx.make``, ``chunk`` experts at a time."""
+
+    parts = [_nvfp4(fp8x.dense(weight[e0:e0 + chunk], scale[e0:e0 + chunk]))
+             for e0 in range(0, weight.shape[0], chunk)]
+    return tuple(torch.cat(p) for p in zip(*parts))
+
+
+def make(gate: tuple, up: tuple, down: tuple) -> nvx.Experts4:
+    """The FP8 stacks ``fp8x.make`` takes -> grouped NVFP4 experts (the shared one last, as in the FP8 table)."""
+
+    return nvx.make(from_fp8(*gate), from_fp8(*up), from_fp8(*down))
