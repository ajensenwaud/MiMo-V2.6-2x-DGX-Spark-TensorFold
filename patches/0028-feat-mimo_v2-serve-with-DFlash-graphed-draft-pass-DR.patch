+class DraftRunner:
+    """The draft pass replayed as a CUDA graph per stream count, inputs staged into fixed buffers (both ranks run the
+    same replays: the head's gather inside them pairs up). ``TF_MIMO_DRAFT_GRAPHS=0`` runs it eagerly."""
+
+    def __init__(self, drafter: Drafter) -> None:
+        import os
+
+        self.dr = drafter
+        self.use_graphs = os.environ.get("TF_MIMO_DRAFT_GRAPHS", "1") != "0"
+        self.entries: dict[int, tuple] = {}
+        self.pool = torch.cuda.graph_pool_handle() if self.use_graphs else None
+
+    def __call__(self, tokens: list[int], positions: list[int], slots: list[int]) -> list[list[int]]:
+        import gc
+
+        s = len(tokens)
+        dev = self.dr.model.w.embed.device
+        host = torch.tensor([*tokens, *positions, *slots], dtype=torch.int64)
+        if not self.use_graphs:
+            buf = host.to(dev)
+            out = self.dr.draft(buf[:s], buf[s:2 * s], buf[2 * s:])
+            return out.tolist()
+        entry = self.entries.get(s)
+        if entry is None:
+            pinned = torch.zeros(3 * s, dtype=torch.int64).pin_memory()
+            buf = torch.zeros(3 * s, dtype=torch.int64, device=dev)
+            pinned.copy_(host)
+            buf.copy_(pinned, non_blocking=True)
+            self.dr.draft(buf[:s], buf[s:2 * s], buf[2 * s:])           # warm-up: grows scratch, compiles kernels
+            torch.cuda.synchronize()
+            g = torch.cuda.CUDAGraph()
+            enabled = gc.isenabled()
+            gc.disable()
+            try:
+                with torch.cuda.graph(g, pool=self.pool):
+                    out = self.dr.draft(buf[:s], buf[s:2 * s], buf[2 * s:])
+            finally:
+                if enabled:
+                    gc.enable()
+            entry = self.entries[s] = (g, pinned, buf, out)
+        g, pinned, buf, out = entry
+        pinned.copy_(host)
+        buf.copy_(pinned, non_blocking=True)
+        g.replay()
+        return out.tolist()
