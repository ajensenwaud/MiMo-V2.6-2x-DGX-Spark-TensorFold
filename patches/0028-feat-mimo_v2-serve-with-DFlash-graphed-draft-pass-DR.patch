diff --git a/src/tensorfold/families/mimo_v2/cuda/dflash.py b/src/tensorfold/families/mimo_v2/cuda/dflash.py
index e704af7..682fc66 100644
--- a/src/tensorfold/families/mimo_v2/cuda/dflash.py
+++ b/src/tensorfold/families/mimo_v2/cuda/dflash.py
@@ -181,3 +181,50 @@ class Drafter:
         h = ops.rms(x, self.norm, self.eps).view(S, B, self.hidden)[:, 1:].reshape(S * (B - 1), self.hidden)
         logits = self.model._head(h.contiguous())[:, :self.model.cfg.vocab]
