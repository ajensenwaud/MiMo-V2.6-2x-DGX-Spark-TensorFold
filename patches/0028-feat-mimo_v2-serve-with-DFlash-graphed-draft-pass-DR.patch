+# Cost of a forward against one row, measured with a different text a stream (4.0 pack, TP=2,
+# results/tp2/grid-cost-4.0.json): GRID[streams][rows a stream - 1]. Rows from different streams route to fewer
+# shared experts than one stream's consecutive rows, so the stream count matters, not just the rows. Uneven windows
+# use the mean; past 4 streams, the 3 -> 4 step repeats. DRAFT_COST: the batched draft pass against one row
+# (graphed). PROBE: rounds between re-checks of a lone stream that stopped drafting.
+GRID = {1: [1.00, 1.26, 1.50, 1.75, 2.01, 2.25, 2.46, 2.67],
+        2: [1.41, 1.92, 2.43, 2.88, 3.23, 3.61, 3.92, 4.23],
+        3: [1.77, 2.57, 3.24, 3.79, 4.29, 4.99, 5.40, 5.81],
+        4: [2.12, 3.13, 3.94, 4.66, 5.42, 6.00, 6.52, 7.03]}
+DRAFT_COST = float(os.environ.get("TF_MIMO_DRAFT_COST", "0.25"))   # measured: 6.05 ms graphed vs 24.7 ms a row (4.0)
+PROBE = 8
+
+
+def cost(streams: int, rows: int) -> float:
+    """The measured cost of a forward of ``rows`` rows over ``streams`` streams, against one row."""
+
+    def at(s: int, mean: float) -> float:
+        row = GRID[s]
+        if mean >= len(row):
+            return row[-1] + (mean - len(row)) * (row[-1] - row[-2])
+        lo = int(mean)
+        return row[lo - 1] + (mean - lo) * (row[lo] - row[lo - 1]) if lo < len(row) else row[-1]
+
+    mean = max(1.0, rows / streams)
+    if streams <= 4:
+        return at(streams, mean)
+    return at(4, mean) + (streams - 4) * (at(4, mean) - at(3, mean))
+
+
+def joint_widths(alphas: list[float], mosts: list[int], budget: int, others: int = 0) -> list[int]:
+    """Every drafting stream's window (1 .. its most rows), chosen together for the whole forward (``others``
+    streams ride along at one row): draft rows are added one at a time where the expected gain is largest (alpha **
+    the stream's current width: the chance all its earlier drafts hold), and the prefix of additions with the most
+    expected tokens per unit of the forward's measured cost wins. No additions means no draft pass, so its cost is
+    not charged."""
+
+    w = [1] * len(alphas)
+    streams = len(w) + others
+    tokens, rows = float(streams), streams
+    best, best_rate = list(w), tokens / cost(streams, rows)
+    while rows < budget:
+        gains = [(a ** w[i], i) for i, a in enumerate(alphas) if w[i] < mosts[i]]
+        if not gains:
+            break
+        g, i = max(gains)
+        w[i] += 1
+        tokens, rows = tokens + g, rows + 1
+        rate = tokens / (cost(streams, rows) + DRAFT_COST)
+        if rate > best_rate:
+            best, best_rate = list(w), rate
+    return best
 
 
