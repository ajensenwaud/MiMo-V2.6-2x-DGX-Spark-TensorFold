+"""Kolibri 1 on two ranks, simulated on one GPU (a thread a rank, an in-process all-gather): rank-equal logits that
+track the one-GPU forward, and the forward descriptions rank 1 follows."""
+
+from __future__ import annotations
+
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+sys.path.insert(0, str(Path(__file__).parent))
+
+from kolibri1_tiny import write  # noqa: E402
+
+
+class PairComm:
+    """Two threads' all-gather in rank order: each publishes its send, both copy both."""
+
+    def __init__(self, shared: dict, rank: int) -> None:
+        self.shared, self.rank, self.world = shared, rank, 2
+
+    def all_gather(self, send: torch.Tensor, recv: torch.Tensor) -> None:
+        torch.cuda.synchronize()
+        self.shared[self.rank] = send.detach().clone()
+        self.shared["bar"].wait()
+        r = recv.view(2, -1)
+        r[0].copy_(self.shared[0].reshape(-1))
+        r[1].copy_(self.shared[1].reshape(-1))
+        torch.cuda.synchronize()
+        self.shared["bar"].wait()
+
+    def barrier(self) -> None:
+        self.shared["bar"].wait()
+
+
+def pair(fn):
+    shared = {"bar": threading.Barrier(2, timeout=120)}
+    out, errors = [None, None], []
+
+    def run(rank):
+        try:
+            out[rank] = fn(rank, PairComm(shared, rank))
+        except BaseException as e:              # noqa: BLE001
+            errors.append(e)
+            shared["bar"].abort()
+
+    ts = [threading.Thread(target=run, args=(r,)) for r in (0, 1)]
+    for t in ts:
+        t.start()
+    for t in ts:
+        t.join()
+    if errors:
+        raise errors[0]
+    return out
+
+
+@pytest.fixture(scope="module")
+def tiny(tmp_path_factory) -> Path:
+    return write(tmp_path_factory.mktemp("kolibri1-tiny-tp"), width=256)
+
+
+def tokens(n: int, seed: int = 0) -> list[int]:
+    g = torch.Generator().manual_seed(seed)
+    return torch.randint(0, 500, (n,), generator=g).tolist()
+
+
+def decode(model, prompt, steps, slot=0):
+    from tensorfold.families.kolibri1.cuda.forward import Chain
+
+    rows = [model.prefill(prompt, slot=slot)[0]]
+    nxt, pos = int(rows[0].argmax()), len(prompt)
+    for _ in range(steps):
+        r = model.forward([Chain(slot, pos, [nxt])], prompt=False, rows=range(1))[0]
+        rows.append(r)
+        nxt, pos = int(r.argmax()), pos + 1
+    return torch.stack(rows)
+
+
+def test_two_ranks_agree_bit_for_bit_and_track_one_gpu(tiny):
+    from tensorfold.families.kolibri1.cuda.forward import Model
+    from tensorfold.families.kolibri1.cuda.weights import load
+
+    prompt = tokens(60, seed=7)
+    one = decode(Model(load(tiny), 256), prompt, 12)
+
+    def rank_run(rank, comm):
+        return decode(Model(load(tiny, rank=rank, world=2), 256, comm=comm), prompt, 12)
+
+    r0, r1 = pair(rank_run)
+    assert torch.equal(r0, r1)
+    assert r0.shape == one.shape
+    cos = torch.nn.functional.cosine_similarity(r0, one, dim=-1)
+    assert cos.min() > 0.995, cos
+    assert (r0.argmax(-1) == one.argmax(-1)).all()
+
+
+def test_a_ranks_share_halves_heads_experts_and_vocab(tiny):
+    from tensorfold.families.kolibri1.cuda.weights import load
+
+    full, half = load(tiny), load(tiny, rank=1, world=2)
+    assert half.config.heads * 2 == full.config.heads and half.config.kv_heads * 2 == full.config.kv_heads
+    assert half.head.shape[0] * 2 == full.head.shape[0]
+    assert torch.equal(half.head, full.head[full.head.shape[0] // 2:])
+    assert half.layers[0].experts.width * 2 == full.layers[0].experts.width
+
+
+def test_rank_one_receives_the_forwards_rank_zero_describes():
+    from tensorfold.families.kolibri1.cuda.forward import Chain
+    from tensorfold.families.kolibri1.cuda.tp import DECODE, PROMPT, STOP, Mirror
+
+    sent = [(PROMPT, [Chain(1, 0, tokens(700, seed=1))]),             # longer than one header
+            (DECODE, [Chain(0, 33, [5]), Chain(2, 90, [7, 8, 9])]),
+            (STOP, [])]
+
+    def run(rank, comm):
+        m = Mirror(comm, rank)
+        if rank == 0:
+            for kind, chains in sent:
+                m.send(kind, chains)
+            return None
+        return [m.receive() for _ in sent]
+
+    _, got = pair(run)
+    for (kind, chains), (k, c) in zip(sent, got):
+        assert k == kind
+        assert [(x.slot, x.p0, list(x.tokens)) for x in c] == [(x.slot, x.p0, list(x.tokens)) for x in chains]
