+++ b/src/tensorfold/families/mimo_v2/cuda/graphs.py
@@ -0,0 +1,114 @@
+"""Decode forwards replayed as CUDA graphs per (chain widths, full-attention key bucket); inputs in fixed buffers.
+
+A replay launches the eager decode forward's kernels with the same grids: full layers read ``bucket / CK`` key chunks
+(chunks past a row's position are skipped inside the kernel), so a replayed row carries the eager row's bits for any
+position within the bucket. Shapes outside the graphed set fall back to the eager forward.
+"""
+
+from __future__ import annotations
+
+import gc
+import os
+from collections import OrderedDict
+from typing import Sequence
+
+import torch
+
+from . import attention, ops
+from .forward import Chain, Model
+
+BUCKET = 8192            # smallest key span a graph covers; longer contexts take the next power of two
+KEEP = int(os.environ.get("TF_MIMO_GRAPHS_KEEP", "48"))      # graphs held (least recently replayed dropped)
+MAX_ROWS = 32            # widest window graphed
+
+
+class Staged:
+    """A key's fixed device inputs and the pinned host mirror refreshed before each replay."""
+
+    def __init__(self, model: Model, widths: tuple[int, ...], bucket: int) -> None:
+        dev = model.w.embed.device
+        self.widths, self.width, self.streams = widths, sum(widths), len(widths)
+        self.chunks = bucket // attention.CK
+        w = self.width
+        self.host32 = torch.zeros(2 * w, dtype=torch.int32).pin_memory()      # positions, slots
+        self.dev32 = torch.zeros(2 * w, dtype=torch.int32, device=dev)
+        self.pos32, self.slot32 = self.dev32[:w], self.dev32[w:]
+        self.host64 = torch.zeros(w, dtype=torch.int64).pin_memory()
+        self.ids = torch.zeros(w, dtype=torch.int64, device=dev)
+
+    def refresh(self, chains: Sequence[Chain]) -> None:
+        w = self.width
+        h32, h64 = self.host32.numpy(), self.host64.numpy()
+        at = 0
+        for c in chains:
+            n = len(c.tokens)
+            h64[at:at + n] = c.tokens
+            h32[at:at + n] = range(c.p0, c.p0 + n)
+            h32[w + at:w + at + n] = c.slot
+            at += n
+        self.dev32.copy_(self.host32, non_blocking=True)
+        self.ids.copy_(self.host64, non_blocking=True)
+
+
+class Graphs:
+    def __init__(self, model: Model) -> None:
+        self.model = model
+        self.pool = torch.cuda.graph_pool_handle()
+        self.entries: OrderedDict[tuple, tuple] = OrderedDict()
+        self.replays = self.captures = self.eager = 0
+
+    def _bucket(self, end: int) -> int:
+        return min(-(-self.model.context // attention.CK) * attention.CK,
+                   max(BUCKET, 1 << (end - 1).bit_length()))
+
+    def eligible(self, chains: Sequence[Chain]) -> bool:
+        widths = [len(c.tokens) for c in chains]
+        return max(widths) <= MAX_ROWS and sum(widths) <= ops.DECODE_ROWS
+
+    @torch.no_grad()
+    def forward(self, chains: Sequence[Chain]) -> torch.Tensor:
+        """fp32 logits of every row of ``chains`` (decode rows only)."""
+
+        m = self.model
+        if not self.eligible(chains):
+            self.eager += 1
+            return m.forward(chains, prompt=False, rows=range(sum(len(c.tokens) for c in chains)))
+        m.check(chains)
+        widths = tuple(len(c.tokens) for c in chains)
+        key = (widths, self._bucket(max(c.p0 + len(c.tokens) for c in chains)))
+        entry = self.entries.get(key)
+        if entry is None:
+            entry = self._capture(key, chains)
+        else:
+            self.entries.move_to_end(key)
+        g, staged, out = entry
+        staged.refresh(chains)
+        g.replay()
+        self.replays += 1
+        return out
+
+    def _capture(self, key, chains):
+        while len(self.entries) >= KEEP:
+            self.entries.popitem(last=False)
+        staged = Staged(self.model, key[0], key[1])
+        staged.refresh(chains)
+
+        def run():
+            return self.model.forward(None, prompt=False, staged=staged)
+
+        # A warm-up run writes the same cache rows the replay will (idempotent: same inputs, same bits) and grows
+        # every scratch buffer to this shape before capture.
+        run()
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        enabled = gc.isenabled()
+        gc.disable()                                   # collecting an old graph mid-capture invalidates it
+        try:
+            with torch.cuda.graph(g, pool=self.pool):
+                out = run()
+        finally:
+            if enabled:
+                gc.enable()
+        self.captures += 1
+        entry = self.entries[key] = (g, staged, out)
+        return entry
