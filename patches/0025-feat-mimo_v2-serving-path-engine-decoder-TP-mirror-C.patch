--- /dev/null
+++ b/src/tensorfold/families/mimo_v2/cuda/tp.py
@@ -0,0 +1,80 @@
+"""MiMo-V2 on two ranks: rank 0 schedules; every forward it runs is described to rank 1, which runs the same one.
+
+The description (kind, chains, tokens) goes through NCCL, which waits without a limit while rank 1 idles; the
+forward's own all-gathers go over RoCE when they fit. Both ranks gather the same partials and sum them in rank
+order, so their logits are bit-equal and only rank 0 samples.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from .forward import Chain
+
+HEADER = 256            # int32 words a description carries in one gather; longer ones send the rest in a second
+STOP, PROMPT, DECODE = 0, 1, 2
+
+
+def _nccl(comm):
+    return getattr(comm, "nccl", comm)                # RoceComm wraps NCCL; descriptions take NCCL's unbounded wait
+
+
+class Mirror:
+    def __init__(self, comm, rank: int) -> None:
+        self.comm, self.rank = _nccl(comm), rank
+
+    def _gather(self, words: list[int], n: int) -> list[int]:
+        mine = torch.zeros(n, dtype=torch.int32)
+        if self.rank == 0:
+            mine[:len(words)] = torch.tensor(words, dtype=torch.int32)
+        got = torch.empty(2 * n, dtype=torch.int32, device="cuda")
+        self.comm.all_gather(mine.pin_memory().cuda(non_blocking=True), got)
+        if self.rank == 0:                               # its own words: no wait on the gather here
+            return (list(words) + [0] * n)[:n]
+        return got[:n].tolist()                          # rank 0's words
+
+    def send(self, kind: int, chains=()) -> None:
+        assert self.rank == 0
+        words = [kind, len(chains), sum(len(c.tokens) for c in chains)]
+        for c in chains:
+            words += [c.slot, c.p0, len(c.tokens)]
+        for c in chains:
+            words += list(c.tokens)
+        self._exchange(words)
+
+    def _exchange(self, words: list[int]) -> list[int]:
+        head = self._gather(words[:HEADER], HEADER)
+        kind, n, total = head[0], head[1], head[2]
+        size = 3 + 3 * n + total
+        if size > HEADER:
+            head = head + self._gather(words[HEADER:size], size - HEADER)
+        return head[:size]
+
+    def receive(self) -> tuple[int, list[Chain]]:
+        assert self.rank == 1
+        w = self._exchange([])
+        kind, n = w[0], w[1]
+        chains, at = [], 3 + 3 * n
+        for i in range(n):
+            slot, p0, length = w[3 + 3 * i:6 + 3 * i]
+            chains.append(Chain(slot, p0, w[at:at + length]))
+            at += length
+        return kind, chains
+
+
+def follow(model, graphs, mirror: Mirror) -> None:
+    """Rank 1: run every forward rank 0 describes until it says stop."""
+
+    while True:
+        kind, chains = mirror.receive()
+        if kind == STOP:
+            return
+        try:
+            if kind == PROMPT:
+                model.forward(chains, prompt=True)
+            elif graphs is not None:
+                graphs.forward(chains)
+            else:
+                model.forward(chains, prompt=False, rows=range(sum(len(c.tokens) for c in chains)))
+        except ValueError as exc:            # refused before any gather, on rank 0 too (the same check)
+            print(f"[tensorfold] mimo_v2 rank 1: {exc}", flush=True)
