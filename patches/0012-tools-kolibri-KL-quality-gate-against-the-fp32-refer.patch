diff --git a/tools/kolibri_kl.py b/tools/kolibri_kl.py
new file mode 100644
index 0000000..b1fd425
--- /dev/null
+++ b/tools/kolibri_kl.py
@@ -0,0 +1,115 @@
+"""Quality gate: KL(fp32 reference || engine) on real text, prompt rows and decode rows, for any engine config.
+
+  ref:    python3 tools/kolibri_kl.py ref    MODEL OUT.pt                 (one GPU, nothing else loaded)
+  engine: python3 tools/kolibri_kl.py engine MODEL REF.pt [--tp 2 --rank R --master ADDR]  (rank 0 prints)
+
+Each text is tokenized, its first PROMPT tokens run as a prompt (every row's logits kept), and the next DECODE tokens
+are fed one at a time (teacher-forced) through the decode path (graphs unless TF_KOLIBRI_GRAPHS=0).
+"""
+
+import argparse
+import os
+import sys
+
+import torch
+
+TEXTS = [
+    "Die Hauptstadt von Frankreich ist Paris. Sie liegt an der Seine und ist seit dem Mittelalter das politische und "
+    "kulturelle Zentrum des Landes. Zu den bekanntesten Sehenswürdigkeiten gehören der Eiffelturm, der Louvre und "
+    "die Kathedrale Notre-Dame, die nach dem Brand im Jahr 2019 aufwendig restauriert wurde.",
+    "def fibonacci(n):\n    \"\"\"Return the n-th Fibonacci number iteratively.\"\"\"\n    a, b = 0, 1\n    for _ in range(n):\n"
+    "        a, b = b, a + b\n    return a\n\n\nif __name__ == \"__main__\":\n    for i in range(10):\n        print(i, fibonacci(i))\n",
+    "The mitochondrion is a double-membrane-bound organelle found in most eukaryotic organisms. Mitochondria generate "
+    "most of the cell's supply of adenosine triphosphate, which is used as a source of chemical energy. They were "
+    "first discovered by Albert von Kölliker in 1857 in the voluntary muscles of insects.",
+    "Sehr geehrte Damen und Herren,\n\nhiermit kündige ich meinen Vertrag mit der Kundennummer 4711 fristgerecht zum "
+    "nächstmöglichen Zeitpunkt. Bitte senden Sie mir eine schriftliche Bestätigung der Kündigung unter Angabe des "
+    "Beendigungszeitpunktes zu.\n\nMit freundlichen Grüßen",
+]
+PROMPT, DECODE = 40, 24
+
+
+def token_ids(model_dir):
+    from transformers import AutoTokenizer
+
+    tok = AutoTokenizer.from_pretrained(model_dir)
+    out = []
+    for t in TEXTS:
+        ids = tok(t, add_special_tokens=False)["input_ids"]
+        if len(ids) < PROMPT + DECODE:
+            raise SystemExit(f"text too short: {len(ids)} tokens")
+        out.append(ids[:PROMPT + DECODE])
+    return out
+
+
+def ref(model_dir, out):
+    sys.path.insert(0, "tests/cuda")
+    from kolibri1_reference import Kolibri
+
+    seqs = token_ids(model_dir)
+    k = Kolibri(model_dir)
+    logits = []
+    for ids in seqs:
+        k.caches = [None] * k.L
+        got, _ = k.forward(ids, 0)
+        logits.append(got.float().cpu())
+    torch.save({"ids": seqs, "logits": logits}, out)
+    print(f"saved {len(seqs)} x {logits[0].shape} reference logits to {out}")
+
+
+def engine(model_dir, ref_path, tp, rank, master):
+    from tensorfold.families.kolibri1.cuda.forward import Chain, Model
+    from tensorfold.families.kolibri1.cuda.weights import load
+
+    torch.cuda.set_device(0)
+    comm = None
+    if tp == 2:
+        from tensorfold.cuda.comm import open_comm
+        from tensorfold.cuda.roce import RoceComm
+
+        comm = RoceComm(open_comm(rank, 2, master, int(os.environ.get("PORT", "29571"))), rank, 2)
+        comm.settle()
+    data = torch.load(ref_path)
+    m = Model(load(model_dir, rank=rank, world=tp), 4096, slots=1, comm=comm)
+    graphs = None
+    if os.environ.get("TF_KOLIBRI_GRAPHS", "1") != "0":
+        from tensorfold.families.kolibri1.cuda.graphs import Graphs
+
+        graphs = Graphs(m)
+    kls_p, kls_d, agree_p, agree_d = [], [], [], []
+    for ids, want in zip(data["ids"], data["logits"]):
+        got_p = m.forward([Chain(0, 0, ids[:PROMPT])], prompt=True, rows=range(PROMPT)).float().cpu()
+        got_d = []
+        for i in range(PROMPT, PROMPT + DECODE):
+            c = [Chain(0, i, [ids[i]])]
+            r = graphs.forward(c) if graphs is not None else m.forward(c, prompt=False, rows=range(1))
+            got_d.append(r[0].float().cpu())
+        got = torch.cat([got_p, torch.stack(got_d)])
+        lp, lq = torch.log_softmax(want, -1), torch.log_softmax(got, -1)
+        kl = (lp.exp() * (lp - lq)).sum(-1)
+        top = want.argmax(-1) == got.argmax(-1)
+        kls_p.append(kl[:PROMPT])
+        kls_d.append(kl[PROMPT:])
+        agree_p.append(top[:PROMPT])
+        agree_d.append(top[PROMPT:])
+    if rank == 0:
+        kp, kd = torch.cat(kls_p), torch.cat(kls_d)
+        ap, ad = torch.cat(agree_p).float().mean(), torch.cat(agree_d).float().mean()
+        label = f"tp={tp} graphs={'on' if graphs else 'off'}"
+        print(f"{label}: prompt rows KL mean {kp.mean():.5f} max {kp.max():.4f} top1 {ap:.3f} | "
+              f"decode rows KL mean {kd.mean():.5f} max {kd.max():.4f} top1 {ad:.3f}")
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser()
+    p.add_argument("mode", choices=("ref", "engine"))
+    p.add_argument("model")
+    p.add_argument("path")
+    p.add_argument("--tp", type=int, default=1)
+    p.add_argument("--rank", type=int, default=0)
+    p.add_argument("--master", default="")
+    a = p.parse_args()
+    if a.mode == "ref":
+        ref(a.model, a.path)
+    else:
+        engine(a.model, a.path, a.tp, a.rank, a.master)
