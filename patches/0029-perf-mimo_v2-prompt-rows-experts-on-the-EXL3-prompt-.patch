+class RoundProfile:
+    """Debug (TF_MIMO_PROFILE_ROUNDS=1): a decode round's wall time split into phases, the GPU synchronised at each
+    boundary so device time lands in the phase that launched it; averages printed every 200 rounds, by stream count."""
+
+    EVERY = 200
+
+    def __init__(self) -> None:
+        self.acc: dict[int, dict] = {}
+
+    def start(self) -> None:
+        import torch
+
+        torch.cuda.synchronize()
+        self.t0 = self.t = time.perf_counter()
+        self.cur: dict[str, float] = {}
+
+    def mark(self, phase: str) -> None:
+        import torch
+
+        torch.cuda.synchronize()
+        now = time.perf_counter()
+        self.cur[phase] = self.cur.get(phase, 0.0) + now - self.t
+        self.t = now
+
+    def end(self, streams: int, rows: int) -> None:
+        a = self.acc.setdefault(streams, {"n": 0, "rows": 0, "wall": 0.0, "phases": {}})
+        a["n"] += 1
+        a["rows"] += rows
+        a["wall"] += self.t - self.t0
+        for k, v in self.cur.items():
+            a["phases"][k] = a["phases"].get(k, 0.0) + v
+        if a["n"] % self.EVERY == 0:
+            n = a["n"]
+            ph = " ".join(f"{k} {v / n * 1e3:.2f}" for k, v in a["phases"].items())
+            print(f"[tensorfold] mimo_v2 rounds, {streams} stream(s): {n} rounds, {a['rows'] / n:.1f} rows, "
+                  f"{a['wall'] / n * 1e3:.2f} ms a round | {ph} (ms)", flush=True)
+
