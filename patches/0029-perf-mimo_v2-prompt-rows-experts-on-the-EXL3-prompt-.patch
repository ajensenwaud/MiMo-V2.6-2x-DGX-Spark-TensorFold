 """MiMo-V2's MoE: fp32 router logits, top 8 by sigmoid score plus the correction bias (ties to the lower id), each
-weighted by its sigmoid score normalised over the 8 (times layer 47's interm_div), on the grouped EXL3 kernel."""
+weighted by its sigmoid score normalised over the 8 (times layer 47's interm_div).
+
+Decode rows run the grouped EXL3 kernel (row-invariant: a row's bits do not depend on its neighbours). Prompt rows
+of a big chunk run per expert on the prompt GEMM instead: the grouped kernel re-decodes each expert's trellis for
+every small group of rows (measured: 72% of an 8192-row chunk), while the prompt GEMM decodes each matrix once and
+runs a tiled GEMM over all of that expert's rows. Sums go in expert order, so the result is deterministic and the
+ranks' partials stay bit-equal."""
 
 from __future__ import annotations
 
+import os
+
 import torch
 import triton
 import triton.language as tl
 
 from tensorfold.cuda import moe as shared
 from tensorfold.cuda.exl3 import experts as x3experts
+from tensorfold.cuda.exl3 import prefill as x3prefill
+from tensorfold.cuda.exl3.linear import Exl3Linear
 
 WINDOW = 1024            # rows a routed call (its grouping keeps every pick in shared memory)
-_EXL3_ROUTER = __import__("os").environ.get("TF_MIMO_DEBUG_EXL3_ROUTER") == "1"
+PROMPT_EXPERTS_MIN = int(os.environ.get("TF_MIMO_PROMPT_EXPERTS_MIN", "256"))   # prompt rows from which experts run
+                                                                                 # per expert on the prompt GEMM
+_EXL3_ROUTER = os.environ.get("TF_MIMO_DEBUG_EXL3_ROUTER") == "1"
 
 
 @triton.jit
@@ -35,16 +47,36 @@ def _topk(L, BIAS, PICK, WTS, SCALE, NE: tl.constexpr, TOPK: tl.constexpr, BLOCK
     tl.store(WTS + r * TOPK + ak, w, mask=ak < TOPK)
 
 
+def _linears(ex: x3experts.Exl3RoutedExperts) -> list:
+    """Each expert's (gate, up, down) as Exl3Linear views of the layer's trellises (no copies), built once."""
+
+    lins = getattr(ex, "_mimo_linears", None)
+    if lins is None:
+        E, keep = ex.count, ex.keep
+        if len(keep) != 3 * E:
+            raise ValueError("expected the layer's gate, up and down trellises in prepare()'s order")
+
+        def lin(t, suh, svh):
+            return Exl3Linear.from_tensors(t, suh, svh, "mul1", device=t.device, layout="stored")
+
+        lins = [(lin(keep[e], ex.suh_g[e], ex.svh_g[e]), lin(keep[E + e], ex.suh_u[e], ex.svh_u[e]),
+                 lin(keep[2 * E + e], ex.suh_d[e], ex.svh_d[e])) for e in range(E)]
+        ex._mimo_linears = lins
+    return lins
+
+
 class MoE:
     """Scratch shared by every MoE layer (they have one shape)."""
 
     def __init__(self, ex: x3experts.Exl3RoutedExperts, top_k: int, device) -> None:
         self.top_k = top_k
         self.scratch = x3experts.Scratch(ex, WINDOW, top_k, device=device)
+        self.ws = x3prefill.Workspace()
 
     def __call__(self, x: torch.Tensor, router: torch.Tensor, bias: torch.Tensor, ex: x3experts.Exl3RoutedExperts,
-                 scale: float) -> torch.Tensor:
-        """x [R, D] bf16 -> [R, D] fp32: the weighted sum of its experts (a rank's share of their width under TP)."""
+                 scale: float, prompt: bool = False) -> torch.Tensor:
+        """x [R, D] (activation dtype) -> [R, D] fp32: the weighted sum of its experts (a rank's share of their width
+        under TP)."""
 
         rows, experts, k = x.shape[0], router.shape[0], self.top_k
         x = x.contiguous()
@@ -56,8 +88,59 @@ class MoE:
         wts = torch.empty((rows, k), dtype=torch.float32, device=x.device)
         _topk[(rows,)](logits, bias, pick, wts, float(scale), NE=experts, TOPK=k,
                        BLOCK=triton.next_power_of_2(experts), KP=triton.next_power_of_2(k), num_warps=4)
+        if prompt and rows >= PROMPT_EXPERTS_MIN:
+            return self._prompt(x, pick, wts, ex, float(scale))
         out = torch.empty((rows, ex.dims), dtype=torch.float32, device=x.device)
         for r0 in range(0, rows, WINDOW):
             n = min(WINDOW, rows - r0)
             x3experts.routed(x[r0:r0 + n], pick[r0:r0 + n], wts[r0:r0 + n], ex, self.scratch, out[r0:r0 + n], n)
         return out
+
+    def _prompt(self, x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor,
+                ex: x3experts.Exl3RoutedExperts, scale: float) -> torch.Tensor:
+        """Per expert on the prompt GEMM. The routed copies of the rows are gathered once in expert order, so each
+        expert reads and writes a contiguous slice; the normalised routing weight (<= 1) is folded into the down
+        projection's input (exact: down is linear), the layer's scale (layer 47's interm_div compensation, x128)
+        applied once to the fp32 sum so the 16-bit activations cannot overflow; the 8 results a row are summed in
+        slot order (deterministic)."""
+
+        rows, k = pick.shape
+        lins = _linears(ex)
+        flat = pick.reshape(-1).long()
+        order = torch.argsort(flat, stable=True)                           # (row, slot) pairs grouped by expert
+        counts = torch.bincount(flat, minlength=ex.count).tolist()         # one host sync a layer
+        xs = x.index_select(0, order // k)                                 # [rows*k, D], expert order
+        ws = (wts.reshape(-1).index_select(0, order) / scale).contiguous()
+        g = torch.empty((rows * k, ex.width), dtype=x.dtype, device=x.device)
+        u = torch.empty_like(g)
+        h = torch.empty_like(g)
+        d = torch.empty((rows * k, ex.dims), dtype=torch.float32, device=x.device)
+        at = 0
+        for e, c in enumerate(counts):
+            if c == 0:
+                continue
+            gate, up, down = lins[e]
+            s = slice(at, at + c)
+            x3prefill.matmul(gate, xs[s], g[s], self.ws)
+            x3prefill.matmul(up, xs[s], u[s], self.ws)
+            _silu_mul_scale[(c,)](g[s], u[s], ws[s], h[s], N=ex.width, BLOCK=triton.next_power_of_2(ex.width),
+                                  num_warps=4)
+            x3prefill.matmul(down, h[s], d[s], self.ws)
+            at += c
+        inv = torch.empty_like(order)
+        inv[order] = torch.arange(order.numel(), device=order.device)
+        out = d.index_select(0, inv).view(rows, k, ex.dims).sum(1)
+        return out if scale == 1.0 else out * scale
+
+
+@triton.jit
+def _silu_mul_scale(G, U, W, OUT, N: tl.constexpr, BLOCK: tl.constexpr):
+    """A row: silu(g) * u * w (fp32 math), to the activation dtype."""
+
+    r = tl.program_id(0).to(tl.int64)
+    c = tl.arange(0, BLOCK)
+    ok = c < N
+    g = tl.load(G + r * N + c, mask=ok, other=0.0).to(tl.float32)
+    u = tl.load(U + r * N + c, mask=ok, other=0.0).to(tl.float32)
+    w = tl.load(W + r)
+    tl.store(OUT + r * N + c, (g / (1.0 + tl.exp(-g)) * u * w).to(OUT.dtype.element_ty), mask=ok)
