diff --git a/tools/kolibri_qmm_sweep.py b/tools/kolibri_qmm_sweep.py
new file mode 100644
index 0000000..480cfb1
--- /dev/null
+++ b/tools/kolibri_qmm_sweep.py
@@ -0,0 +1,54 @@
+"""Sweep qmm.split_k's program target for Kolibri's decode projections (TP1 and TP2 shapes), DRAM-bound timing."""
+
+import torch
+
+from tensorfold.cuda.kernels import qmm
+from tensorfold.cuda.nvfp4.linear import Fp8BlockLinear
+
+COPIES, REPS = 16, 200
+orig = qmm.split_k
+
+
+def lin(n, k):
+    w = (torch.randn(n, k, device="cuda") * 0.05).to(torch.float8_e4m3fn)
+    return Fp8BlockLinear.from_checkpoint(w, torch.rand(-(-n // 128), k // 128, device="cuda") * 0.01 + 0.001)
+
+
+def gpu_us(fn):
+    fn(0)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for i in range(REPS):
+            fn(i % COPIES)
+    g.replay()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(5):
+        g.replay()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) * 1000 / (5 * REPS)
+
+
+shapes = {"tp1 qkv": (7168, 2560), "tp1 o": (2560, 6144), "tp2 qkv": (3584, 2560), "tp2 o": (2560, 3072)}
+for name, (n, k) in shapes.items():
+    ws = [lin(n, k) for _ in range(COPIES)]
+    x = torch.randn(1, k, device="cuda").to(torch.bfloat16)
+    want = ws[0](x).float()
+    row = []
+    for target in (192, 384, 768, 1536):
+        qmm.split_k = lambda n_, k_, gs=64, target_=target: _sk(n_, k_, gs, target_)
+
+        def _sk(n_, k_, gs, t):
+            tiles, groups, sk = -(-n_ // 64), k_ // gs, 1
+            while sk < 32 and tiles * sk < t and groups % (sk * 2) == 0 and groups // (sk * 2) >= 2:
+                sk *= 2
+            return sk
+        globals()["_sk"] = _sk
+        us = gpu_us(lambda i: ws[i](x))
+        err = (ws[0](x).float() - want).abs().max().item()
+        row.append(f"t{target}: sk {_sk(n, k, 64, target):>2} {us:6.1f} us {n * k / us / 1e3:5.0f} GB/s (dmax {err:.1e})")
+    qmm.split_k = orig
+    print(f"{name:<8}", " | ".join(row), flush=True)
