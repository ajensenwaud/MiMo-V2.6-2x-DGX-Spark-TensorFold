     return Experts4(u, d, us, down[2].to(torch.float32).reshape(-1, 1).contiguous(), width, dims, float(limit))
 
 
+def _parts(env: str, kg: int) -> int:
+    """K parts for a decode matmul of ``kg`` 32-input blocks, fixed by the shape (never the rows); env unset: 1."""
+
+    import os
+
+    s = int(os.environ.get(env, "1"))
+    while s > 1 and kg % (2 * s):
+        s -= 1
+    return max(1, s)
+
+
 def _run(epi: int, x: torch.Tensor, slots: int, w: torch.Tensor, scale: torch.Tensor, kg: int, nb: int,
          plan: grouped.Plan, out: torch.Tensor, n: int, limit: float, skip: int, rows: int) -> None:
     from .linear import _ext
 
     units = grouped.max_items(rows * plan.slots, plan.experts, plan.tile) * nb
+    s = 1 if plan.prefill or skip >= 0 else _parts("TF_NVFP4_SPLITK_GATEUP" if epi == 2 else "TF_NVFP4_SPLITK_DOWN", kg)
+    if s > 1:                                          # decode: more warps on the few experts a row reads
+        pairs = rows * plan.slots
+        partials = torch.empty((s, pairs, 2 if epi == 2 else 1, n), dtype=torch.float32, device=x.device)
+        _ext().experts_split(epi, x, x.stride(0), slots, w, scale, kg, nb, s, plan.items, plan.counts, plan.members,
+                             out, n, limit, units, partials, pairs)
+        return
     _ext().experts(epi, x, x.stride(0), slots, w, scale, kg, nb, plan.items, plan.counts, plan.members, out, n,
                    limit, skip, units)
 
