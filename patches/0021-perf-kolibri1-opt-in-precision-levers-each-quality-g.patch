+// Decode with K split in ``s`` parts: fp32 partials [s, pairs, M, n], then their sum in part order through the
+// epilogue. Every pair must be routed to a computed expert (no skip).
+void experts_split(int64_t epi, const at::Tensor& x, int64_t x_stride, int64_t slots, const at::Tensor& w,
+                   const at::Tensor& scale, int64_t kg, int64_t nb, int64_t s, const at::Tensor& items,
+                   const at::Tensor& counts, const at::Tensor& members, at::Tensor out, int64_t n, double limit,
+                   int64_t max_units, at::Tensor partials, int64_t pairs) {
+    TORCH_CHECK(x.is_cuda() && x.scalar_type() == at::kBFloat16 && x.stride(1) == 1 && x_stride % 4 == 0,
+                "x: bf16 rows, 8-byte aligned");
+    TORCH_CHECK(w.is_contiguous() && w.scalar_type() == at::kInt && w.size(-1) == 144, "w: [E, N/32, K/32, M, 144]");
+    TORCH_CHECK(scale.is_contiguous() && scale.scalar_type() == at::kFloat, "scale: [E, M] fp32");
+    TORCH_CHECK(out.is_contiguous() && out.scalar_type() == (epi == 0 ? at::kFloat : at::kBFloat16), "out dtype");
+    nvfp4_experts_split_cuda(epi, x, x_stride, slots, w, scale, kg, nb, s, items, counts, members, out, n, limit,
+                             max_units, partials, pairs);
+}
+
