+class Cache:
+    """Re-quantised experts on disk (``TF_KOLIBRI_QUANT_CACHE``: a directory), one file a (layer, rank), keyed by the
+    checkpoint's index file, the rank's share and this module's recipe, so a restart skips the minutes of quantising."""
+
+    VERSION = "nvfp4-mse4-v1"
+
+    def __init__(self, model_dir, kind: str, rank: int, world: int) -> None:
+        import hashlib
+        import os
+        from pathlib import Path
+
+        root = os.environ.get("TF_KOLIBRI_QUANT_CACHE", "")
+        self.dir = None
+        if root and kind.startswith("nvfp4"):
+            index = (Path(model_dir) / "model.safetensors.index.json").read_bytes()
+            key = hashlib.sha256(index + f"{self.VERSION}/{kind}/{rank}/{world}".encode()).hexdigest()[:16]
+            self.dir = Path(root) / f"kolibri1-{kind}-r{rank}of{world}-{key}"
+            self.dir.mkdir(parents=True, exist_ok=True)
+
+    def get(self, layer: int, device):
+        if self.dir is None or not (self.dir / f"{layer}.pt").is_file():
+            return None
+        return torch.load(self.dir / f"{layer}.pt", map_location=device, weights_only=False)
+
+    def put(self, layer: int, ex) -> None:
