+    q = quant.from_fp8(w[:2], s[:2])
+    ex = nvx.make(q, q, q)
+    got = torch.stack([nvx.dense(ex, i, "gate") for i in range(2)])
+    assert ((got - ref).norm() / ref.norm()).item() < 0.10                 # 4-bit on Gaussian weights: ~8.8%
+
+
+def test_fp8_head_is_close_and_row_independent():
+    from tensorfold.cuda import moe as shared
+    from tensorfold.families.kolibri1.cuda.head import Head8
+
+    torch.manual_seed(2)
+    w = (torch.randn(4096, D, device="cuda") * 0.02).to(torch.bfloat16)
+    h = Head8(w)
+    x = torch.randn(5, D, device="cuda").to(torch.bfloat16)
+    want, got = shared.router(x, w), h(x)
+    assert ((got - want).norm() / want.norm()).item() < 0.03
+    assert torch.equal(h(x[2:3].contiguous()), got[2:3])
+
+
+def test_fp8_kv_tree_attention_equals_bf16_on_the_same_values():
+    from tensorfold.families.kolibri1.cuda import attention
+
+    torch.manual_seed(3)
+    hk, h, d, ctx = 2, 24, 128, 700
+    k8 = (torch.randn(ctx, hk, d, device="cuda")).to(torch.float8_e4m3fn)
+    v8 = (torch.randn(ctx, hk, d, device="cuda")).to(torch.float8_e4m3fn)
+    kb, vb = k8.to(torch.bfloat16), v8.to(torch.bfloat16)
+    q = torch.randn(3, h, d, device="cuda").to(torch.bfloat16)
+    kn = torch.randn(3, hk, d, device="cuda").to(torch.bfloat16)
+    vn = torch.randn(3, hk, d, device="cuda").to(torch.bfloat16)
+    a8 = attention.full_rows(q, kn, vn, [(k8, v8)], [(3, 650)], scale=d ** -0.5)
+    ab = attention.full_rows(q, kn, vn, [(kb, vb)], [(3, 650)], scale=d ** -0.5)
+    assert torch.equal(a8, ab)
