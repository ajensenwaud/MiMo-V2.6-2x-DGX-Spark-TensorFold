+"""Kolibri 1's LM head in FP8 (opt-in, quality-gated): e4m3 rows with an fp32 scale per (row, 128 inputs), fp32 logits.
+
+Half the head's bytes a token. A row's logits never depend on the other rows: K runs in BK steps in order."""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+from tensorfold.cuda.moe import _tile
+
+BK = 128
+
+
+@triton.jit
+def _head8(X, W, S, OUT, M, x_stride, D: tl.constexpr, NE: tl.constexpr, BM: tl.constexpr,
+           BLOCK_E: tl.constexpr, BK: tl.constexpr):
+    """OUT[m, e] = sum over K blocks of fp32 (x[m, blk] . bf16(w8[e, blk])) * s[e, blk]."""
+
+    rm = tl.program_id(0) * BM + tl.arange(0, BM)
+    re = tl.program_id(1) * BLOCK_E + tl.arange(0, BLOCK_E)
+    rk = tl.arange(0, BK)
+    m_ok = rm < M
+    e_ok = re < NE
+    acc = tl.zeros((BM, BLOCK_E), dtype=tl.float32)
+    for k0 in range(0, D, BK):
+        x = tl.load(X + rm[:, None] * x_stride + (k0 + rk)[None, :], mask=m_ok[:, None], other=0.0)
+        w = tl.load(W + re[:, None] * D + (k0 + rk)[None, :], mask=e_ok[:, None], other=0.0).to(tl.bfloat16)
+        s = tl.load(S + re * (D // BK) + k0 // BK, mask=e_ok, other=0.0)
+        acc += tl.dot(x, tl.trans(w)) * s[None, :]
+    tl.store(OUT + rm[:, None] * NE + re[None, :], acc, mask=m_ok[:, None] & e_ok[None, :])
+
+
+class Head8:
+    """[V, D] bf16 head -> e4m3 with per-(row, 128) fp32 scales (amax / 448)."""
+
+    def __init__(self, head: torch.Tensor) -> None:
+        v, d = head.shape
+        blocks = head.float().view(v, d // BK, BK)
+        self.scale = (blocks.abs().amax(-1) / 448.0).clamp_min(1e-30).contiguous()      # [V, D/BK]
+        self.w8 = (blocks / self.scale[..., None]).to(torch.float8_e4m3fn).view(v, d).contiguous()
+        self.v, self.d = v, d
+
+    def nbytes(self) -> int:
+        return self.w8.numel() + self.scale.numel() * 4
+
+    def __call__(self, x: torch.Tensor) -> torch.Tensor:
+        x = x if x.dtype == torch.bfloat16 and x.stride(-1) == 1 else x.to(torch.bfloat16).contiguous()
+        m = x.shape[0]
+        out = torch.empty((m, self.v), dtype=torch.float32, device=x.device)
+        bm = _tile(m)
+        be, stages = (64, 4) if bm == 16 else (64, 3)
+        grid = (triton.cdiv(m, bm), triton.cdiv(self.v, be))
+        _head8[grid](x, self.w8, self.scale, out, m, x.stride(0), D=self.d, NE=self.v, BM=bm, BLOCK_E=be, BK=BK,
+                     num_warps=4, num_stages=stages)
+        return out
