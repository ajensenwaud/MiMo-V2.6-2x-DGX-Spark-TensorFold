@@ -0,0 +1,70 @@
+"""moe.run, FP8 vs NVFP4 (all three matrices) vs mixed (NVFP4 gate/up, FP8 down): decode rows and prompt chunks.
+
+  NI=512 (one Spark) or NI=256 (a TP=2 rank's share) python3 tools/kolibri_moe_fp4_bench.py
+Graph-replayed decode over 16 rotated layers so weights miss L2; prompt chunks timed eagerly.
+"""
+
+import os
+
+import torch
+
+from tensorfold.cuda.fp8 import experts as fp8x
+from tensorfold.families.kolibri1.cuda import moe, quant
+
+torch.manual_seed(0)
+D, E, COPIES, REPS = 2560, 384, 16, 100
+NI = int(os.environ.get("NI", "512"))
+PART = NI < 512
+
+
+def mats(n, k):
+    return ((torch.randn(E + 1, n, k, device="cuda") * 0.05).to(torch.float8_e4m3fn),
+            torch.rand(E + 1, n // 128, k // 128, device="cuda") * 0.01 + 0.001)
+
+
+kinds = {"fp8": [], "nvfp4": [], "mixed": []}
+for _ in range(COPIES):
+    g, u, d = mats(NI, D), mats(NI, D), mats(D, NI)
+    kinds["fp8"].append(fp8x.make(g, u, d))
+    kinds["nvfp4"].append(quant.make(g, u, d))
+    kinds["mixed"].append(quant.make_mixed(g, u, d))
+routers = [(torch.randn(E, D, device="cuda") * 0.02).to(torch.bfloat16) for _ in range(COPIES)]
+bias = torch.zeros(E, device="cuda")
+
+
+def timed(fn):
+    fn(0)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for i in range(REPS):
+            fn(i % COPIES)
+    g.replay()
+    torch.cuda.synchronize()
+    a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+    a.record()
+    for _ in range(5):
+        g.replay()
+    b.record()
+    torch.cuda.synchronize()
+    return a.elapsed_time(b) * 1000 / (5 * REPS)
+
+
+for rows in (1, 4, 16):
+    x = torch.randn(rows, D, device="cuda").to(torch.bfloat16)
+    t = {k: timed(lambda i, v=v: moe.run(x, routers[i], bias, v[i], 6, partial=PART)) for k, v in kinds.items()}
+    print(f"NI {NI} decode rows {rows:>2}: " + "  ".join(f"{k} {us:6.1f} us" for k, us in t.items()), flush=True)
+for rows in (2048, 8192):
+    x = torch.randn(rows, D, device="cuda").to(torch.bfloat16)
+    res = []
+    for k, v in kinds.items():
+        moe.run(x, routers[0], bias, v[0], 6, prefill=True, partial=PART)
+        torch.cuda.synchronize()
+        a, b = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        a.record()
+        for _ in range(3):
+            moe.run(x, routers[0], bias, v[0], 6, prefill=True, partial=PART)
+        b.record()
+        torch.cuda.synchronize()
+        res.append(f"{k} {a.elapsed_time(b) / 3:6.2f} ms")
+    print(f"NI {NI} prompt {rows}: " + "  ".join(res), flush=True)
