+"""Full-attention layers' cached K and V magnitudes on real text: what an e4m3 cache (scale 1) would keep."""
+
+import sys
+
+import torch
+
+sys.path.insert(0, "tools")
+from kolibri_nll import corpus  # noqa: E402
+
+from tensorfold.families.kolibri1.cuda.forward import Chain, Model  # noqa: E402
+from tensorfold.families.kolibri1.cuda.weights import load  # noqa: E402
+
+model_dir, folder = sys.argv[1:3]
+torch.cuda.set_device(0)
+m = Model(load(model_dir), 4200, slots=1)
+docs = dict(corpus(model_dir, folder))
+for name in ("agent_gpt2-codegolf", "de_Photosynthese"):
+    ids = docs[name][:2048]
+    m.forward([Chain(0, 0, ids)], prompt=True)
+    print(name)
+    for i, full in enumerate(m.cfg.full):
+        if not full:
+            continue
+        for kind, t in (("k", m.k[i][0, :len(ids)]), ("v", m.k[i][0, :len(ids)] if False else m.v[i][0, :len(ids)])):
+            a = t.float().abs()
+            q = (t.to(torch.float8_e4m3fn).float() - t.float()).norm() / t.float().norm()
+            print(f"  layer {i:2d} {kind}: amax {a.max():8.3f}  median {a.median():.4f}  "
+                  f"<2^-6 {(a < 2 ** -6).float().mean():.3f}  e4m3 rel err {q:.4f}  per-head amax "
+                  f"{[round(x, 2) for x in a.amax(dim=(0, 2)).tolist()]}")
