+++ b/tools/kolibri_nll.py
@@ -0,0 +1,104 @@
+"""Bigger quality gate: teacher-forced NLL and top-32 KL against the as-shipped engine, on a corpus of real text.
+
+  ref:  python3 tools/kolibri_nll.py ref  MODEL CORPUS_DIR OUT.pt      (as shipped: default env)
+  eval: python3 tools/kolibri_nll.py eval MODEL CORPUS_DIR REF.pt      (any TF_KOLIBRI_* config, one rank)
+
+Each *.txt in CORPUS_DIR is tokenized and cut to TOKENS tokens, then run as a prompt in CHUNK-row chunks with every
+row's logits kept. The reference keeps each row's top-K log-probabilities; eval reports perplexity per file group
+(the file name's prefix before '_'), the change in mean NLL, top-1 agreement and KL(ref || eval) over the reference's
+top-K tokens plus one bucket for the rest of the mass.
+"""
+
+import os
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import torch
+
+TOKENS, CHUNK, K = 4096, 2048, 32
+
+
+def corpus(model_dir, folder):
+    from transformers import AutoTokenizer
+
+    tok = AutoTokenizer.from_pretrained(model_dir)
+    out = []
+    for f in sorted(Path(folder).glob("*.txt")):
+        ids = tok(f.read_text(), add_special_tokens=False)["input_ids"][:TOKENS]
+        out.append((f.stem, ids))
+    return out
+
+
+def run(model_dir, docs):
+    from tensorfold.families.kolibri1.cuda.forward import Chain, Model
+    from tensorfold.families.kolibri1.cuda.weights import load
+
+    torch.cuda.set_device(0)
+    if os.environ.get("KL_PREFILL_FP8"):                 # --prefill-fp8's numerics for the prompt projections
+        from tensorfold.cuda import prompt_precision
+
+        prompt_precision.set_fp8(True)
+    m = Model(load(model_dir), TOKENS + 64, slots=1)
+    decode = os.environ.get("NLL_PATH") == "decode"         # teacher-forced 32-row decode windows (draft-style)
+    step = 32 if decode else CHUNK
+    for name, ids in docs:
+        rows = []
+        for a in range(0, len(ids), step):
+            part = ids[a:a + step]
+            logits = m.forward([Chain(0, a, part)], prompt=not decode, rows=range(len(part)))
+            rows.append(torch.log_softmax(logits.float(), -1))
+        yield name, ids, torch.cat(rows)
+
+
+def ref(model_dir, folder, out):
+    docs = corpus(model_dir, folder)
+    saved = {}
+    for name, ids, lp in run(model_dir, docs):
+        tgt = torch.tensor(ids[1:], device=lp.device)
+        top = lp[:-1].topk(K, -1)
+        saved[name] = {"ids": ids, "nll": -lp[:-1].gather(1, tgt[:, None])[:, 0].cpu(),
+                       "top_lp": top.values.cpu(), "top_ix": top.indices.int().cpu()}
+        print(f"{name}: {len(ids)} tokens, ppl {saved[name]['nll'].mean().exp():.3f}", flush=True)
+    torch.save(saved, out)
+
+
+def evaluate(model_dir, folder, ref_path):
+    want = torch.load(ref_path)
+    docs = [(n, want[n]["ids"]) for n in sorted(want)]
+    group = defaultdict(lambda: {"n0": [], "n1": [], "kl": [], "top": []})
+    for name, ids, lp in run(model_dir, docs):
+        r = want[name]
+        tgt = torch.tensor(ids[1:], device=lp.device)
+        nll = -lp[:-1].gather(1, tgt[:, None])[:, 0].cpu()
+        p_lp, ix = r["top_lp"].to(lp.device), r["top_ix"].to(lp.device).long()
+        q_lp = lp[:-1].gather(1, ix)
+        p_rest = (1 - p_lp.exp().sum(-1)).clamp_min(1e-12)
+        q_rest = (1 - q_lp.exp().sum(-1)).clamp_min(1e-12)
+        kl = (p_lp.exp() * (p_lp - q_lp)).sum(-1) + p_rest * (p_rest.log() - q_rest.log())
+        g = group[name.split("_")[0]]
+        if os.environ.get("NLL_DUMP"):
+            big = (kl > 1.0).nonzero()[:, 0].tolist()
+            print(f"{name}: {len(big)} rows KL>1, first at {big[:12]}, chunk-2 share "
+                  f"{sum(b >= CHUNK for b in big) / max(1, len(big)):.2f}", flush=True)
+        g["n0"].append(r["nll"])
+        g["n1"].append(nll)
+        g["kl"].append(kl.cpu())
+        g["top"].append((lp[:-1].argmax(-1) == ix[:, 0]).float().cpu())
+    tot = {k: [] for k in ("n0", "n1", "kl", "top")}
+    for name, g in sorted(group.items()) + [("ALL", tot)]:
+        if name != "ALL":
+            for k in tot:
+                tot[k] += g[k]
+        n0, n1, kl, top = (torch.cat(g[k]) for k in ("n0", "n1", "kl", "top"))
+        print(f"{name:<6} tokens {len(n0):6d}  ppl {n0.mean().exp():7.3f} -> {n1.mean().exp():7.3f} "
+              f"({(n1.mean() - n0.mean()).exp() * 100 - 100:+.2f}%)  KL mean {kl.mean():.4f} p99 {kl.quantile(0.99):.3f}"
+              f"  top1 {top.mean():.4f}", flush=True)
+
+
+if __name__ == "__main__":
+    mode, model, folder, path = sys.argv[1:5]
+    if mode == "ref":
+        ref(model, folder, path)
+    else:
+        evaluate(model, folder, path)
