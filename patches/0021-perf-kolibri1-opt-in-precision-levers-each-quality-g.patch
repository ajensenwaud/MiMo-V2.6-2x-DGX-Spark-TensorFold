+"""Kolibri 1's opt-in lower-precision paths: NVFP4 experts (split K), the FP8 head and FP8 full-layer KV caches."""
+
+import os
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+
+D, E, NI = 2560, 16, 256
+
+
+def fp8_mats(n, k):
+    return ((torch.randn(E + 1, n, k, device="cuda") * 0.05).to(torch.float8_e4m3fn),
+            torch.rand(E + 1, n // 128, k // 128, device="cuda") * 0.01 + 0.001)
+
+
+def run_moe(ex, x, router, bias, gate_up_parts, down_parts, monkeypatch):
+    from tensorfold.families.kolibri1.cuda import moe
+
+    monkeypatch.setenv("TF_NVFP4_SPLITK_GATEUP", str(gate_up_parts))
+    monkeypatch.setenv("TF_NVFP4_SPLITK_DOWN", str(down_parts))
+    return moe.run(x, router, bias, ex, 6, partial=True)
+
+
+def test_nvfp4_split_k_matches_unsplit_and_rows_stay_independent(monkeypatch):
+    from tensorfold.families.kolibri1.cuda import quant
+
+    torch.manual_seed(0)
+    ex = quant.make(fp8_mats(NI, D), fp8_mats(NI, D), fp8_mats(D, NI))
+    router = (torch.randn(E, D, device="cuda") * 0.02).to(torch.bfloat16)
+    bias = torch.zeros(E, device="cuda")
+    x = torch.randn(9, D, device="cuda").to(torch.bfloat16)
+    whole = run_moe(ex, x, router, bias, 1, 1, monkeypatch)
+    split = run_moe(ex, x, router, bias, 8, 2, monkeypatch)
+    assert ((split - whole).norm() / whole.norm()).item() < 1e-5            # a regrouped fp32 sum, no more
+    for r in (0, 4, 8):                                                     # a row's bits never depend on the batch
+        assert torch.equal(run_moe(ex, x[r:r + 1].contiguous(), router, bias, 8, 2, monkeypatch), split[r:r + 1])
+
+
+def test_nvfp4_requantisation_error_is_bounded():
+    from tensorfold.cuda.fp8 import experts as fp8x
+    from tensorfold.cuda.nvfp4 import experts as nvx
