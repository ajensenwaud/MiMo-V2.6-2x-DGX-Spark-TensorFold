+"""MiMo-V2.6-Flash (mimo_v2): Xiaomi's MoE with sliding-window and full attention, from EXL3 packs, on CUDA."""
+# 48 layers: 39 sliding (window 128, sink logits) and 9 full; 256 routed experts, top 8 by sigmoid score plus bias.
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+MODEL_TYPES = ("mimo_v2",)
+TITLE = "MiMo-V2.6-Flash"
+MODELS = ("benthecarman/MiMo-V2.6-Flash-RL-exl3",)
+QUANT_METHODS = {"cuda": ("exl3",)}
+EXL3_VARIANT = "any"           # tensorfold.families.EXL3_VARIANT_ANY: every width; the loader takes the mul1 codebook
+
+
+def check(model_dir: str | Path) -> None:
+    """An EXL3 pack of the mimo_v2 architecture (any bit widths, the mul1 codebook)."""
+
+    from .cuda.weights import Config
+
+    Config.read(model_dir)
+
+
+def cuda_engine(model_dir: str | Path, *, drafter: str = "", tp: int = 1, rank: int = 0, master: str = "",
+                master_port: int = 29551, no_drafts: bool = False, mtp_drafts: int | None = None,
+                context: int | None = None, **options: Any):
+    """One GPU or two ranks (--tp 2); ``--parallel`` requests decoded together; the context sized from memory."""
+
+    if drafter:
+        raise ValueError(f"{TITLE}: the DFlash drafter is not wired on CUDA yet: drop --drafter")
+    if int(tp) not in (1, 2):
+        raise ValueError(f"{TITLE} runs on one GPU or two ranks (--tp 2)")
+    from .cuda.engine import MiMoEngine
+
+    return MiMoEngine(Path(model_dir), context=int(context) if context else None,
+                      explicit=bool(options.get("context_explicit")),
+                      streams=max(1, int(options.get("parallel") or 1)),
+                      tp=int(tp), rank=int(rank), master=master, port=int(master_port))
