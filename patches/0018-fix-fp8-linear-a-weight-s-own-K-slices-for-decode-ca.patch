diff --git a/tests/cuda/test_fp8_block_own_slices.py b/tests/cuda/test_fp8_block_own_slices.py
new file mode 100644
index 0000000..d0f6870
--- /dev/null
+++ b/tests/cuda/test_fp8_block_own_slices.py
@@ -0,0 +1,33 @@
+"""A weight's own K slices (``Fp8BlockLinear.sk``): decode rows batch-independent at any M; prompt rows untouched."""
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+
+
+def make(n=2560, k=6144, sk=16):
+    from tensorfold.cuda.nvfp4.linear import Fp8BlockLinear
+
+    torch.manual_seed(0)
+    w = (torch.randn(n, k, device="cuda") * 0.05).to(torch.float8_e4m3fn)
+    s = torch.rand(n // 128, k // 128, device="cuda") * 0.01 + 0.001
+    lin = Fp8BlockLinear.from_checkpoint(w, s)
+    lin.sk = sk
+    return lin
+
+
+def test_own_slices_keep_rows_independent_of_m_including_fused_sizes():
+    lin = make()
+    x = torch.randn(300, lin.k, device="cuda").to(torch.bfloat16)
+    full = lin(x)                                            # 300 rows: past FUSED_ROWS, must not refuse
+    for m in (1, 7, 33, 256):
+        assert torch.equal(lin(x[:m].contiguous()), full[:m])
+
+
+def test_prompt_rows_use_the_shape_rule():
+    lin = make()
+    x = torch.randn(40, lin.k, device="cuda").to(torch.bfloat16)
+    got = lin.prefill(x)
+    lin.sk = None
+    assert torch.equal(got, lin(x))
