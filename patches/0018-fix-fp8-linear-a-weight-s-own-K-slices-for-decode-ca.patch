 tests/cuda/test_fp8_block_own_slices.py       | 33 +++++++++++++++++++
 tools/kolibri_kl.py                           |  5 ++-
 4 files changed, 48 insertions(+), 6 deletions(-)
 create mode 100644 tests/cuda/test_fp8_block_own_slices.py

