diff --git a/src/tensorfold/families/kolibri1/cuda/graphs.py b/src/tensorfold/families/kolibri1/cuda/graphs.py
new file mode 100644
index 0000000..d11323d
--- /dev/null
+++ b/src/tensorfold/families/kolibri1/cuda/graphs.py
@@ -0,0 +1,133 @@
+"""Decode forwards replayed as CUDA graphs per (chain widths, full-attention key bucket); inputs in fixed buffers."""
+# A replay launches the same kernels on the same plan as the eager forward (padded plans skip what the keys don't
+# fill), so its rows carry the eager rows' bits. Shapes outside the graphed set fall back to the eager forward.
+
+from __future__ import annotations
+
+import gc
+import os
+from collections import OrderedDict
+from typing import Sequence
+
+import torch
+
+from . import attention
+from .forward import Chain, Model
+
+BUCKET = 8192            # smallest key span a graph covers; longer contexts take the next power of two
+KEEP = int(os.environ.get("TF_KOLIBRI_GRAPHS_KEEP", "48"))      # graphs held (least recently replayed dropped)
+MAX_ROWS = 32            # widest window graphed
+
+
+class Staged:
+    """A key's fixed device inputs and the pinned host mirror refreshed before each replay."""
+
+    def __init__(self, model: Model, widths: tuple[int, ...], bucket: int) -> None:
+        from tensorfold.cuda.kernels import attention as tree
+
+        dev = model.w.embed.device
+        self.widths, self.width, self.streams = widths, sum(widths), len(widths)
+        w, s = self.width, self.streams
+        group = model.cfg.heads // model.cfg.kv_heads
+        flat, n_items, most = attention.padded_host(widths, bucket, group)
+        self.plan_dev = torch.tensor(flat, dtype=torch.int32, device=dev)
+        self.plan = tree.from_packed(self.plan_dev, s, w, n_items, most)      # paths: the chains', fixed
+        self.table = self.plan_dev[w:w + 4 * s]                               # (first row, rows, keys, slots) a stream
+        self.host32 = torch.zeros(2 * w + 4 * s, dtype=torch.int32).pin_memory()   # pos, slot, table
+        self.dev32 = torch.zeros(2 * w, dtype=torch.int32, device=dev)
+        self.pos32, self.slot32 = self.dev32[:w], self.dev32[w:]
+        self.host64 = torch.zeros(w + s, dtype=torch.int64).pin_memory()     # ids, stream slots
+        self.dev64 = torch.zeros(w + s, dtype=torch.int64, device=dev)
+        self.ids, self.sslot = self.dev64[:w], self.dev64[w:]
+        bases, strides = model._slot_offsets
+        self.bases, self.strides = bases, strides
+        self.offs = torch.empty((bases.shape[0], s, 2), dtype=torch.int64, device=dev)
+
+    def refresh(self, chains: Sequence[Chain]) -> None:
+        from tensorfold.cuda.kernels import attention as tree
+
+        w, s = self.width, self.streams
+        h32, h64 = self.host32.numpy(), self.host64.numpy()
+        at = 0
+        for i, c in enumerate(chains):
+            n = len(c.tokens)
+            h64[at:at + n] = c.tokens
+            h32[at:at + n] = range(c.p0, c.p0 + n)
+            h32[w + at:w + at + n] = c.slot
+            h32[2 * w + 4 * i:2 * w + 4 * i + 4] = (at, n, c.p0, tree.slots(c.p0, n))
+            h64[w + i] = c.slot
+            at += n
+        self.dev32.copy_(self.host32[:2 * w], non_blocking=True)
+        self.table.copy_(self.host32[2 * w:].view(s, 4).flatten(), non_blocking=True)
+        self.dev64.copy_(self.host64, non_blocking=True)
+
+    def stage_offsets(self) -> None:
+        """Captured: each full layer's (stream, key/value) offsets from the streams' slots."""
+
+        torch.add(self.bases[:, None, :], self.sslot[None, :, None] * self.strides[:, None, :], out=self.offs)
+
+
+class Graphs:
+    def __init__(self, model: Model) -> None:
+        self.model = model
+        if getattr(model, "_slot_offsets", None) is None:
+            model._slot_offsets = attention.slot_offsets(model)
+        self.pool = torch.cuda.graph_pool_handle()
+        self.entries: OrderedDict[tuple, tuple] = OrderedDict()
+        self.replays = self.captures = self.eager = 0
+
+    def _bucket(self, end: int) -> int:
+        return min(self.model.context, max(BUCKET, 1 << (end - 1).bit_length()))
+
+    def eligible(self, chains: Sequence[Chain]) -> bool:
+        widths = [len(c.tokens) for c in chains]
+        return max(widths) <= MAX_ROWS and (len(widths) == 1 or max(widths) == 1)
+
+    @torch.no_grad()
+    def forward(self, chains: Sequence[Chain]) -> torch.Tensor:
+        """fp32 logits of every row of ``chains`` (decode rows only)."""
+
+        m = self.model
+        if not self.eligible(chains):
+            self.eager += 1
+            total = sum(len(c.tokens) for c in chains)
+            return m.forward(chains, prompt=False, rows=range(total))
+        m.check(chains)
+        widths = tuple(len(c.tokens) for c in chains)
+        key = (widths, self._bucket(max(c.p0 + len(c.tokens) for c in chains)))
+        entry = self.entries.get(key)
+        if entry is None:
+            entry = self._capture(key, chains)
+        else:
+            self.entries.move_to_end(key)
+        g, staged, out = entry
+        staged.refresh(chains)
+        g.replay()
+        self.replays += 1
+        return out
+
+    def _capture(self, key, chains):
+        while len(self.entries) >= KEEP:
+            self.entries.popitem(last=False)
+        staged = Staged(self.model, key[0], key[1])
+        staged.refresh(chains)
+
+        def run():
+            staged.stage_offsets()
+            return self.model.forward(None, prompt=False, staged=staged)
+
+        # A warm-up run writes the same cache rows the replay will (idempotent: same inputs, same bits).
+        run()
+        torch.cuda.synchronize()
+        g = torch.cuda.CUDAGraph()
+        enabled = gc.isenabled()
+        gc.disable()                                   # collecting an old graph mid-capture invalidates it
+        try:
+            with torch.cuda.graph(g, pool=self.pool):
+                out = run()
+        finally:
+            if enabled:
+                gc.enable()
+        self.captures += 1
+        entry = self.entries[key] = (g, staged, out)
+        return entry
