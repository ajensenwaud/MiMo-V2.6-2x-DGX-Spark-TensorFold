@@ -0,0 +1,88 @@
+"""Kolibri 1's decode graphs: a replay's rows carry the eager forward's bits, across streams, widths and buckets."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+import torch
+
+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+sys.path.insert(0, str(Path(__file__).parent))
+
+from kolibri1_tiny import write  # noqa: E402
+
+
+@pytest.fixture(scope="module")
+def weights(tmp_path_factory):
+    from tensorfold.families.kolibri1.cuda.weights import load
+
+    return load(write(tmp_path_factory.mktemp("kolibri1-tiny-graphs")))
+
+
+def tokens(n: int, seed: int = 0) -> list[int]:
+    g = torch.Generator().manual_seed(seed)
+    return torch.randint(0, 500, (n,), generator=g).tolist()
+
+
+def pair(weights, context: int, slots: int):
+    from tensorfold.families.kolibri1.cuda.forward import Model
+    from tensorfold.families.kolibri1.cuda.graphs import Graphs
+
+    eager, graphed = Model(weights, context, slots), Model(weights, context, slots)
+    return eager, graphed, Graphs(graphed)
+
+
+def test_graphed_streams_equal_eager_streams(weights):
+    from tensorfold.families.kolibri1.cuda.forward import Chain
+
+    eager, graphed, g = pair(weights, 256, 3)
+    prompts = [tokens(40 + 13 * k, seed=20 + k) for k in range(3)]
+    nxt = []
+    for k, p in enumerate(prompts):
+        a, b = eager.prefill(p, slot=k), graphed.prefill(p, slot=k)
+        assert torch.equal(a, b)
+        nxt.append(int(a.argmax()))
+    pos = [len(p) for p in prompts]
+    for step in range(8):
+        live = [0, 1, 2] if step % 3 else [2, 0]                      # streams come and go: same graph, new slots
+        chains = [Chain(k, pos[k], [nxt[k]]) for k in live]
+        want = eager.forward(chains, prompt=False, rows=range(len(chains)))
+        got = g.forward(chains)
+        assert torch.equal(got, want), step
+        for i, k in enumerate(live):
+            nxt[k], pos[k] = int(want[i].argmax()), pos[k] + 1
+    assert g.captures == 2 and g.replays == 8
+
+
+def test_a_graphed_draft_window_equals_the_eager_window(weights):
+    from tensorfold.families.kolibri1.cuda.forward import Chain
+
+    eager, graphed, g = pair(weights, 256, 1)
+    p = tokens(70, seed=3)
+    eager.prefill(p), graphed.prefill(p)
+    pos = len(p)
+    for width in (1, 5, 5, 12, 1):
+        win = tokens(width, seed=pos)
+        c = [Chain(0, pos, win)]
+        want = eager.forward(c, prompt=False, rows=range(width))
+        assert torch.equal(g.forward(c), want), width
+        pos += width
+
+
+def test_crossing_into_a_larger_bucket_keeps_the_bits(weights, monkeypatch):
+    from tensorfold.families.kolibri1.cuda import graphs
+    from tensorfold.families.kolibri1.cuda.forward import Chain
+
+    monkeypatch.setattr(graphs, "BUCKET", 64)                           # buckets 64, 128, 256 on a 256-token cache
+    eager, graphed, g = pair(weights, 256, 1)
+    p = tokens(50, seed=4)
+    nxt = int(eager.prefill(p).argmax())
+    graphed.prefill(p)
+    for pos in range(50, 140):
+        c = [Chain(0, pos, [nxt])]
+        want = eager.forward(c, prompt=False, rows=range(1))
+        assert torch.equal(g.forward(c), want), pos
+        nxt = int(want[0].argmax())
+    assert {k[1] for k in g.entries} == {64, 128, 256}
