diff --git a/src/tensorfold/families/kolibri1/cuda/attention.py b/src/tensorfold/families/kolibri1/cuda/attention.py
index 458d8c7..4e0e05b 100644
--- a/src/tensorfold/families/kolibri1/cuda/attention.py
+++ b/src/tensorfold/families/kolibri1/cuda/attention.py
@@ -95,3 +95,69 @@ def full_rows(q: torch.Tensor, k_new: torch.Tensor, v_new: torch.Tensor,
                      q.shape[1] // k_new.shape[1], q.device)
     offs = torch.tensor(tree.offsets(caches, q.device), dtype=torch.int64, device=q.device).view(len(groups), 2)
     return tree.attention(q, k_new, v_new, offs, plan, scale=scale)
+
+
+# Full layers' decode attention, planned once a forward. A cache slot's offset from ``tree.base`` is the layer's
+# slot-0 offset plus slot times the slot stride, so a graph computes it on the device from the stream's slot.
+
+def slot_offsets(model) -> tuple[torch.Tensor, torch.Tensor]:
+    """(full layers, 2) int64 slot-0 key/value offsets and (full layers, 2) int64 strides, in bf16 elements."""
+
+    from tensorfold.cuda.kernels import attention as tree
+
+    dev = model.w.embed.device
+    bases, strides = [], []
+    for i, full in enumerate(model.cfg.full):
+        if full:
+            k, v = model.k[i], model.v[i]
+            bases.append(tree.offsets([(k[0], v[0])], dev))
+            strides.append([k.stride(0), v.stride(0)])
+    return (torch.tensor(bases, dtype=torch.int64, device=dev), torch.tensor(strides, dtype=torch.int64, device=dev))
+
+
+def rows_plan(model, chains):
+    """An eager forward's plan and per-full-layer offsets [(S, 2)] for its chains (one copy each to the device)."""
+
+    from tensorfold.cuda.kernels import attention as tree
+
+    if getattr(model, "_slot_offsets", None) is None:
+        model._slot_offsets = slot_offsets(model)
+    bases, strides = model._slot_offsets
+    dev = bases.device
+    group = model.cfg.heads // model.cfg.kv_heads
+    plan = tree.plan([[i - 1 for i in range(len(c.tokens))] for c in chains], [c.p0 for c in chains], group, dev)
+    slots = torch.tensor([c.slot for c in chains], dtype=torch.int64).to(dev, non_blocking=True)
+    offs = (bases[:, None, :] + slots[None, :, None] * strides[:, None, :]).contiguous()
+    return plan, offs
+
+
+def full_planned(q: torch.Tensor, k_new: torch.Tensor, v_new: torch.Tensor, offs: torch.Tensor, plan, *,
+                 scale: float) -> torch.Tensor:
+    from tensorfold.cuda.kernels import attention as tree
+
+    return tree.attention(q, k_new, v_new, offs, plan, scale=scale)
+
+
+def padded_host(widths, bucket: int, group: int) -> tuple[list[int], int, int]:
+    """``tree.plan_host`` for serial chains of ``widths`` over every group and chunk below ``bucket`` keys.
+
+    The streams' rows (first row, rows, committed keys, partial slots) are refreshed per replay; the kernels skip
+    the items those keys do not fill, so a padded plan gives the bits of the exact one."""
+
+    from tensorfold.cuda.kernels import attention as tree
+
+    rows, streams, items, glob = [], [], [], []
+    start = 0
+    codes = list(range(bucket // tree.SPAN)) + [-1 - j for j in range(bucket // tree.CHUNK)]
+    for s, w in enumerate(widths):
+        if not 1 <= w <= tree.MAX_NODES:
+            raise ValueError(f"a stream's window takes 1..{tree.MAX_NODES} rows")
+        rows += [s] * w
+        streams += [start, w, 0, 0]
+        glob += [-1] + [start + i for i in range(w - 1)]
+        for code in codes:
+            for first in range(0, w * group, tree.QUERY_TILE):
+                items += [s, first, code]
+        start += w
+    most = -(-(bucket + max(widths)) // tree.CHUNK)
+    return rows + streams + items + glob, len(items) // 3, most
